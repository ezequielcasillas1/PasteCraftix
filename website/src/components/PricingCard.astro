---
const {
  id,
  name,
  tier,
  price,
  cadence,
  note,
  features = [],
  popular = false,
  billing,
  dataPlan,
} = Astro.props;
---

<article class:list={['pricing-card', 'surface-card', popular && 'popular']} id={id} data-plan={dataPlan}>
  {popular && <span class="badge">Most popular</span>}
  <div class="stack">
    <span class="tier">{tier}</span>
    <h3>{name}</h3>
    <p class="price" id={dataPlan ? `price-${dataPlan}` : undefined}>
      {price}<span>{cadence}</span>
    </p>
    <p class="note">{note}</p>
  </div>

  {billing && (
    <div class="billing-toggle" role="tablist" aria-label={`${name} billing interval`}>
      {Object.entries(billing).map(([key, value], index) => (
        <button type="button" class:list={{ active: index === 1 }} data-plan={dataPlan} data-interval={key}>
          {key[0].toUpperCase() + key.slice(1)}
        </button>
      ))}
    </div>
  )}

  <ul class="feature-list">
    {features.map((feature) => (
      <li>{feature}</li>
    ))}
  </ul>

  <slot />
</article>

<style>
  .pricing-card {
    position: relative;
    padding: 1.5rem;
    display: grid;
    gap: 1.25rem;
  }

  .pricing-card.popular {
    border-color: #bfdbfe;
    background: linear-gradient(180deg, #eff6ff 0%, #ffffff 40%);
    box-shadow: 0 18px 38px -20px rgba(59, 130, 246, 0.3), inset 0 1px 0 #ffffff;
  }

  .badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: linear-gradient(180deg, #3b82f6 0%, #2563eb 100%);
    border: 1px solid #1d4ed8;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  h3 {
    margin: 0;
    font-size: 1.7rem;
  }

  .tier {
    color: var(--brand);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    font-weight: 500;
  }

  .price {
    margin: 0;
    font-size: 3rem;
    line-height: 1;
    font-weight: 300;
    letter-spacing: -0.05em;
  }

  .price span {
    margin-left: 0.35rem;
    font-size: 1rem;
    color: var(--text-muted);
    font-weight: 400;
  }

  .note {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.7;
  }

  .billing-toggle {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.45rem;
    padding: 0.35rem;
    border-radius: 999px;
    background: #f1f5f9;
    border: 1px solid var(--border);
    min-width: 0;
  }

  .billing-toggle button {
    min-height: 2.55rem;
    border-radius: 999px;
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    min-width: 0;
    font-size: 0.85rem;
    padding-inline: 0.35rem;
  }

  .billing-toggle button.active {
    background: #ffffff;
    color: var(--text);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
  }

  @media (max-width: 420px) {
    .price {
      font-size: clamp(2.2rem, 10vw, 3rem);
    }

    .billing-toggle button {
      min-height: 2.35rem;
      font-size: 0.75rem;
    }
  }

  @media (max-width: 340px) {
    .billing-toggle {
      grid-template-columns: 1fr;
      border-radius: var(--radius-md);
    }
  }

  .feature-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.8rem;
    color: var(--text-soft);
  }

  .feature-list li {
    position: relative;
    padding-left: 1.4rem;
    line-height: 1.6;
  }

  .feature-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--brand-soft);
  }
</style>
