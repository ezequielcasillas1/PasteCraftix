---
const { eyebrow, title, copy, narrow = false, headingLevel = 2 } = Astro.props;
const HeadingTag = headingLevel === 1 ? 'h1' : 'h2';
---

<section class="section">
  <div class:list={['container', narrow && 'narrow']}>
    {(eyebrow || title || copy) && (
      <div class="stack intro">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        {title && <HeadingTag class="section-title">{title}</HeadingTag>}
        {copy && <p class="section-copy">{copy}</p>}
      </div>
    )}
    <slot />
  </div>
</section>

<style>
  .intro {
    margin-bottom: 1.5rem;
  }
</style>
