---
import { footerLinks, socialLinks } from '../data/site.js';
---

<footer class="site-footer">
  <div class="container footer-shell surface-card">
    <div class="footer-brand">
      <img src="/logo.svg" alt="PasteCraft logo" width="38" height="38" style="border-radius:10px;flex-shrink:0;box-shadow:0 0 14px rgba(251,191,36,0.18);" />
      <div>
        <strong>PasteCraft</strong>
        <p>Save what you copy. Find it later. Keep it organized.</p>
      </div>
    </div>

    <div class="footer-links">
      <div>
        <h3>Explore</h3>
        <ul>
          {footerLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3>Community</h3>
        <ul>
          {socialLinks.map((item) => (
            <li><a href={item.href} target="_blank" rel="noopener">{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {new Date().getFullYear()} PasteCraft. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 0 0 2rem;
    margin-top: 4rem;
  }

  .footer-shell {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.5rem;
    padding: 1.5rem;
    border-top: 2px solid rgba(251, 191, 36, 0.3);
    box-shadow: 0 -4px 32px rgba(251, 191, 36, 0.06), var(--shadow-md);
    background:
      linear-gradient(180deg, rgba(13, 18, 64, 0.95) 0%, rgba(8, 12, 42, 0.98) 100%),
      var(--surface);
  }

  .footer-brand {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .footer-brand strong {
    display: block;
    margin-bottom: 0.6rem;
    font-size: 1.05rem;
    background: linear-gradient(135deg, #f0f4ff 30%, var(--gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-brand p {
    margin: 0;
    max-width: 44ch;
    color: var(--text-soft);
    line-height: 1.7;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .footer-links h3 {
    margin: 0 0 0.85rem;
    font-size: 0.95rem;
    color: var(--gold);
  }

  .footer-links ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
  }

  .footer-links a {
    text-decoration: none;
    color: var(--text-soft);
    transition: color 180ms ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--gold);
  }

  .footer-bottom {
    padding-top: 1.25rem;
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  @media (max-width: 800px) {
    .footer-shell,
    .footer-links {
      grid-template-columns: 1fr;
    }
  }
</style>
