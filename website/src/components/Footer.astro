---
import { exploreLinks, helpLinks } from '../data/site.js';
---

<footer class="site-footer">
  <div class="container footer-shell surface-card">
    <div class="footer-brand">
      <img src="/logo.svg" alt="PasteCraft logo" width="38" height="38" style="border-radius:10px;flex-shrink:0;box-shadow:0 2px 8px rgba(15,23,42,0.12);" />
      <div>
        <strong>PasteCraft</strong>
        <p>Save what you copy. Find it later. Keep it organized.</p>
      </div>
    </div>

    <div class="footer-links">
      <div>
        <h3>Explore</h3>
        <ul>
          {exploreLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3>Help</h3>
        <ul>
          {helpLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {new Date().getFullYear()} PasteCraft. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 0 0 2rem;
    margin-top: 4rem;
  }

  .footer-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.2fr);
    gap: 1.5rem;
    padding: 1.5rem;
    border-top: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    background: var(--surface-strong);
    max-width: 100%;
    box-sizing: border-box;
  }

  .footer-brand {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    min-width: 0;
  }

  .footer-brand strong {
    display: block;
    margin-bottom: 0.6rem;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .footer-brand p {
    margin: 0;
    max-width: 44ch;
    color: var(--text-soft);
    line-height: 1.7;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .footer-links h3 {
    margin: 0 0 0.85rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--brand);
  }

  .footer-links ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
  }

  .footer-links a {
    text-decoration: none;
    color: var(--text-soft);
    transition: color 180ms ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--brand);
  }

  .footer-bottom {
    padding-top: 1.25rem;
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  @media (max-width: 800px) {
    .footer-shell,
    .footer-links {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .footer-shell {
      padding: 1.15rem;
      gap: 1.15rem;
    }

    .footer-brand {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer-brand p {
      max-width: none;
    }

    .footer-links {
      text-align: center;
    }
  }
</style>
