---
const { items = [] } = Astro.props;
---

<div class="card-grid three">
  {items.map((item) => (
    <article class="feature-card surface-card panel">
      <div class="icon-wrap">
        <span class="icon">{item.icon}</span>
      </div>
      <h3>{item.title}</h3>
      <p>{item.copy}</p>
    </article>
  ))}
</div>

<style>
  .feature-card {
    display: grid;
    gap: 0.85rem;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm), inset 0 1px 0 #ffffff;
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
    position: relative;
    overflow: hidden;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.05) 0%, transparent 60%);
    pointer-events: none;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: #bfdbfe;
    box-shadow: 0 18px 38px -20px rgba(59, 130, 246, 0.25), inset 0 1px 0 #ffffff;
  }

  .icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    background: var(--blue-faint);
    border: 1px solid #dbeafe;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon {
    font-size: 1.6rem;
    line-height: 1;
  }

  h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  p {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.75;
  }
</style>
