---
const { items = [] } = Astro.props;
---

<div class="card-grid three">
  {items.map((item) => (
    <article class="feature-card surface-card panel">
      <div class="icon-wrap">
        <span class="icon">{item.icon}</span>
      </div>
      <h3>{item.title}</h3>
      <p>{item.copy}</p>
    </article>
  ))}
</div>

<style>
  .feature-card {
    display: grid;
    gap: 0.85rem;
    border: 1px solid rgba(37, 99, 235, 0.25);
    box-shadow: 0 8px 32px rgba(8, 12, 42, 0.35), inset 0 1px 0 rgba(251, 191, 36, 0.06);
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
    position: relative;
    overflow: hidden;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.06) 0%, transparent 60%);
    pointer-events: none;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: rgba(251, 191, 36, 0.35);
    box-shadow: 0 16px 48px rgba(8, 12, 42, 0.5), 0 0 24px rgba(251, 191, 36, 0.08);
  }

  .icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.2), rgba(13, 18, 64, 0.4));
    border: 1px solid rgba(37, 99, 235, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon {
    font-size: 1.6rem;
    line-height: 1;
  }

  h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  p {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.75;
  }
</style>
