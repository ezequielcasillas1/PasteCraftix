---
import ShowcaseCardClips from './ShowcaseCard-Clips.astro';
import ShowcaseCardNotes from './ShowcaseCard-Notes.astro';
import ShowcaseCardAILab from './ShowcaseCard-AILab.astro';
import ShowcaseCardCategories from './ShowcaseCard-Categories.astro';

const { class: className = '' } = Astro.props;
---

<div class={`showcase-grid ${className}`}>
  <ShowcaseCardClips class="showcase-card" />
  <ShowcaseCardNotes class="showcase-card" />
  <ShowcaseCardAILab class="showcase-card" />
  <ShowcaseCardCategories class="showcase-card" />
</div>

<style>
  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    width: 100%;
    max-width: 100%;
  }

  @media (min-width: 768px) {
    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .showcase-grid :global(.showcase-card) {
    opacity: 0;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    justify-self: stretch;
    display: flex;
    justify-content: center;
    animation: showcase-card-in 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    transition: transform 300ms ease, box-shadow 300ms ease;
  }

  .showcase-grid :global(.showcase-card > *) {
    width: 100%;
    max-width: min(100%, 420px);
    min-width: 0;
  }

  .showcase-grid :global(.showcase-card:hover) {
    transform: translateY(-4px);
  }

  .showcase-grid :global(.showcase-card:nth-child(1)) {
    animation-delay: 150ms;
  }

  .showcase-grid :global(.showcase-card:nth-child(2)) {
    animation-delay: 300ms;
  }

  .showcase-grid :global(.showcase-card:nth-child(3)) {
    animation-delay: 450ms;
  }

  .showcase-grid :global(.showcase-card:nth-child(4)) {
    animation-delay: 600ms;
  }

  @keyframes showcase-card-in {
    0% {
      opacity: 0;
      transform: translateY(12px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-grid :global(.showcase-card) {
      animation: none;
      opacity: 1;
    }
  }
</style>
