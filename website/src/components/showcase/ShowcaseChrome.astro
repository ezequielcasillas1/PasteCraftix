---
/**
 * Shared mini replica of the real PasteCraft popup chrome:
 * blue-gradient header (logo, title, model picker, AI/Profile/Settings actions)
 * + the full 9-tab nav menu in its 3-row grid (row 3 = full-width Activity).
 * Static and non-functional; `active` marks the current tab.
 */
const { active = 'clips' } = Astro.props;

const tabsRow1 = [
  { id: 'clips', label: 'Clips', icon: 'solar:clipboard-linear' },
  { id: 'search', label: 'Search', icon: 'solar:magnifer-linear' },
  { id: 'categories', label: 'Categories', icon: 'solar:folder-linear' },
  { id: 'ai', label: 'AI Lab', icon: 'solar:star-shine-linear' },
];

const tabsRow2 = [
  { id: 'liked', label: 'Liked', icon: 'solar:heart-linear' },
  { id: 'notes', label: 'Notes', icon: 'solar:notebook-linear' },
  { id: 'widgets', label: 'Widgets', icon: 'solar:widget-2-linear' },
  { id: 'aiHistory', label: 'AI History', icon: 'solar:document-text-linear' },
];

const activityTab = { id: 'activity', label: 'Activity', icon: 'solar:chart-linear' };

const headerActions = [
  { icon: 'solar:star-shine-linear', label: 'AI Lab' },
  { icon: 'solar:user-circle-linear', label: 'Profile' },
  { icon: 'solar:settings-linear', label: 'Settings' },
];
---

<div class="chrome" aria-hidden="true">
  <!-- Header: matches extension .header in light theme -->
  <div class="chrome-header">
    <div class="chrome-logo-section">
      <img src="/logo.svg" alt="" class="chrome-logo" width="34" height="34" />
      <div class="chrome-header-info">
        <p class="chrome-title">PasteCraft</p>
        <p class="chrome-capture">Last capture 2m ago</p>
        <p class="chrome-sync">
          <span class="chrome-sync-dot"></span>
          Synced
          <span class="chrome-clip-count">215 clips</span>
        </p>
      </div>
    </div>
    <div class="chrome-header-right">
      <span class="chrome-model">
        <span class="chrome-model-label">Model</span>
        <span class="chrome-model-value">
          GPT-4o
          <iconify-icon icon="solar:alt-arrow-down-linear" style="stroke-width: 1.5;"></iconify-icon>
        </span>
      </span>
      <div class="chrome-actions">
        {headerActions.map((action) => (
          <span class="chrome-action-btn" title={action.label}>
            <iconify-icon icon={action.icon} style="stroke-width: 1.5;"></iconify-icon>
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Tab nav: matches extension .tab-nav grid (4 + 4 + full-width Activity) -->
  <div class="chrome-tabnav">
    {[...tabsRow1, ...tabsRow2].map((tab) => (
      <span class:list={['chrome-tab', { 'chrome-tab-active': tab.id === active }]}>
        <iconify-icon icon={tab.icon} style="stroke-width: 1.5;"></iconify-icon>
        {tab.label}
      </span>
    ))}
    <span class:list={['chrome-tab', 'chrome-tab-activity', { 'chrome-tab-active': activityTab.id === active }]}>
      <iconify-icon icon={activityTab.icon} style="stroke-width: 1.5;"></iconify-icon>
      {activityTab.label}
    </span>
  </div>
</div>

<style>
  .chrome {
    container-type: inline-size;
    container-name: showcase-chrome;
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .chrome-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 12px 14px;
    background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 52%, #93c5fd 100%);
    color: #1e3a8a;
    min-width: 0;
  }

  .chrome-logo-section {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  .chrome-logo {
    border-radius: 10px;
    filter: drop-shadow(1px 1px 2px rgba(30, 58, 138, 0.28));
    flex-shrink: 0;
  }

  .chrome-header-info {
    min-width: 0;
  }

  .chrome-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #1e3a8a;
    line-height: 1.1;
  }

  .chrome-capture {
    margin: 2px 0 0;
    font-size: 0.625rem;
    font-weight: 300;
    color: rgba(30, 58, 138, 0.85);
  }

  .chrome-sync {
    margin: 3px 0 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.625rem;
    font-weight: 500;
    color: rgba(30, 58, 138, 0.9);
  }

  .chrome-sync-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .chrome-clip-count {
    font-family: var(--font-mono);
    letter-spacing: -0.04em;
    color: rgba(30, 58, 138, 0.7);
  }

  .chrome-header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .chrome-model {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .chrome-model-label {
    font-size: 0.5625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #1e3a8a;
    opacity: 0.75;
  }

  .chrome-model-value {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border: 1px solid rgba(30, 58, 138, 0.35);
    background: rgba(255, 255, 255, 0.78);
    border-radius: 8px;
    padding: 2px 6px;
    font-size: 0.625rem;
    font-weight: 500;
    color: #1e3a8a;
  }

  .chrome-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .chrome-action-btn {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.5);
    color: #1e3a8a;
    font-size: 0.8125rem;
  }

  .chrome-tabnav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4px;
    background: #f8fafc;
    padding: 4px;
    border-bottom: 1px solid #e2e8f0;
    min-width: 0;
  }

  .chrome-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 7px 4px;
    border-radius: 8px;
    font-size: 0.625rem;
    font-weight: 500;
    color: #64748b;
    white-space: nowrap;
    min-width: 0;
    overflow: hidden;
  }

  .chrome-tab iconify-icon {
    font-size: 0.75rem;
    flex-shrink: 0;
  }

  .chrome-tab-activity {
    grid-column: 1 / -1;
  }

  .chrome-tab-active {
    background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
    color: #ffffff;
    box-shadow: 0 2px 4px rgba(59, 130, 246, 0.3);
  }

  @media (max-width: 380px) {
    .chrome-model {
      display: none;
    }
  }

  @container showcase-chrome (max-width: 380px) {
    .chrome-model {
      display: none;
    }

    .chrome-header {
      gap: 0.45rem;
      padding: 10px 10px;
    }

    .chrome-capture,
    .chrome-sync {
      display: none;
    }

    .chrome-tab {
      gap: 0.2rem;
      padding: 6px 2px;
      font-size: 0.5625rem;
    }

    .chrome-tab iconify-icon {
      font-size: 0.7rem;
    }

    .chrome-action-btn {
      width: 24px;
      height: 24px;
    }
  }

  @container showcase-chrome (max-width: 340px) {
    .chrome-tabnav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3px;
    }

    .chrome-tab {
      font-size: 0.55rem;
      gap: 0.15rem;
      padding: 6px 2px;
    }
  }

  @container showcase-chrome (max-width: 280px) {
    .chrome-tab {
      font-size: 0;
      gap: 0;
      padding: 7px 2px;
    }

    .chrome-tab iconify-icon {
      font-size: 0.8rem;
    }

    .chrome-tab-activity {
      font-size: 0.55rem;
      gap: 0.2rem;
    }

    .chrome-tab-activity iconify-icon {
      font-size: 0.7rem;
    }
  }
</style>
