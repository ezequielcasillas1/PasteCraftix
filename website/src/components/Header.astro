---
import { navItems, storeLinks } from '../data/site.js';

const { currentPath = '/' } = Astro.props;
---

<header class="site-header">
  <div class="container header-anchor">
    <div class="header-shell surface-card">
      <a href="/" class="brand" aria-label="PasteCraft home">
        <img
          src="/logo.svg"
          alt=""
          width="32"
          height="32"
          class="brand-logo"
        />
        <span class="brand-text">
          <strong>PasteCraft</strong>
          <small>Clipboard history that stays useful</small>
        </span>
      </a>

      <nav class="site-nav" id="site-primary-nav" aria-label="Primary">
        <ul class="nav-list">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class:list={{ active: currentPath === item.href }}>
                {item.href === '/scholar-vs-merchant' ? (
                  <>
                    <span class="nav-label-full">{item.label}</span>
                    <span class="nav-label-short">Scholar vs Merchant</span>
                  </>
                ) : (
                  item.label
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="header-end">
        <a
          class="header-cta"
          href={storeLinks.chrome}
          target="_blank"
          rel="noopener noreferrer"
        >
          Add to Chrome
        </a>
        <button
          type="button"
          class="nav-toggle"
          id="site-nav-toggle"
          aria-expanded="false"
          aria-controls="site-primary-nav"
        >
          <span class="sr-only">Open menu</span>
          <span class="nav-toggle-bars" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('site-nav-toggle');
  const nav = document.getElementById('site-primary-nav');

  function setNavOpen(open) {
    if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;
    nav.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    const srLabel = toggle.querySelector('.sr-only');
    if (srLabel) {
      srLabel.textContent = open ? 'Close menu' : 'Open menu';
    }
    document.body.classList.toggle('nav-menu-open', open);
  }

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.contains('is-open');
    setNavOpen(!isOpen);
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setNavOpen(false));
  });

  window.addEventListener('resize', () => {
    if (window.matchMedia('(min-width: 64rem)').matches) {
      setNavOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setNavOpen(false);
  });
</script>

<style>
  .site-header {
    padding: 0.5rem 0 0;
    position: sticky;
    top: 0;
    z-index: 30;
    max-width: 100%;
  }

  .header-anchor {
    position: relative;
  }

  .header-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--tap-gap);
    min-height: var(--tap-min);
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 14px 38px -18px rgba(15, 23, 42, 0.25), inset 0 1px 0 #ffffff;
    max-width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    min-width: 0;
    flex-shrink: 0;
    min-height: var(--tap-min);
  }

  .brand-logo {
    border-radius: 10px;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.12);
    width: 32px;
    height: 32px;
  }

  .brand-text {
    min-width: 0;
    display: none;
  }

  .brand strong {
    display: block;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .brand small {
    display: block;
    color: var(--text-muted);
    font-size: 0.78rem;
    margin-top: 0.18rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: var(--tap-gap);
    flex-shrink: 0;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-min);
    padding: 0 0.85rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    color: #ffffff;
    background: var(--gradient-gold);
    border: 1px solid var(--brand-deep);
    box-shadow: var(--shadow-gold);
    white-space: nowrap;
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap-min);
    min-height: var(--tap-min);
    padding: 0;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    cursor: pointer;
    flex-shrink: 0;
  }

  .nav-toggle-bars,
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    display: block;
    width: 1.15rem;
    height: 2px;
    border-radius: 999px;
    background: var(--ink-soft);
    position: relative;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-toggle-bars::before {
    top: -6px;
  }

  .nav-toggle-bars::after {
    top: 6px;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bars {
    background: transparent;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bars::before {
    top: 0;
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .site-nav {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + var(--tap-gap));
    z-index: 40;
    padding: 0.5rem;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    max-height: min(70vh, 28rem);
    overflow-y: auto;
  }

  .site-nav.is-open {
    display: block;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--tap-gap);
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 0 0.85rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: 1rem;
    color: var(--text-soft);
    border: 1px solid transparent;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
    white-space: normal;
    width: 100%;
    box-sizing: border-box;
  }

  .nav-list a.active,
  .nav-list a:hover,
  .nav-list a:focus-visible {
    color: var(--brand);
    border-color: var(--border);
    background: var(--surface-light);
  }

  .nav-label-short {
    display: none;
  }

  @media (min-width: 640px) {
    .header-cta {
      font-size: 0.9375rem;
      padding: 0 1rem;
    }
  }

  @media (min-width: 1024px) {
    .site-header {
      padding: 1rem 0 0;
    }

    .header-shell {
      flex-wrap: nowrap;
      gap: 0.75rem;
      min-height: auto;
      padding: 0.65rem 1.25rem;
      border-radius: 999px;
    }

    .brand-logo {
      width: 42px;
      height: 42px;
      border-radius: 12px;
    }

    .brand-text {
      display: block;
    }

    .header-cta,
    .nav-toggle {
      display: none;
    }

    .site-nav {
      display: block;
      position: static;
      flex: 1 1 auto;
      min-width: 0;
      padding: 0;
      border: none;
      box-shadow: none;
      background: transparent;
      max-height: none;
      overflow: visible;
    }

    .nav-list {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: var(--tap-gap);
    }

    .nav-list a {
      width: auto;
      justify-content: center;
      font-size: 0.875rem;
      padding: 0.5rem 0.85rem;
      border-radius: 999px;
      white-space: nowrap;
    }

    .nav-label-full {
      display: inline;
    }

    .nav-label-short {
      display: none;
    }
  }
</style>
