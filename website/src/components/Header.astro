---
import { navItems } from '../data/site.js';

const { currentPath = '/' } = Astro.props;
---

<header class="site-header">
  <div class="container header-shell surface-card">
    <a href="/" class="brand" aria-label="PasteCraft home">
      <img src="/logo.svg" alt="PasteCraft logo" width="42" height="42" class="brand-logo" />
      <span>
        <strong>PasteCraft</strong>
        <small>Clipboard clarity for modern work</small>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class:list={{ active: currentPath === item.href }}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding: 1.25rem 0 0;
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(12px);
  }

  .header-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid rgba(251, 191, 36, 0.12);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    min-width: 0;
  }

  .brand-logo {
    border-radius: 12px;
    flex-shrink: 0;
    box-shadow: 0 0 12px rgba(251, 191, 36, 0.15);
  }

  .brand strong {
    display: block;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    background: linear-gradient(135deg, #f0f4ff 30%, var(--gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .brand small {
    display: block;
    color: var(--text-muted);
    font-size: 0.78rem;
    margin-top: 0.18rem;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 2.7rem;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--text-soft);
    border: 1px solid transparent;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .nav-list a.active,
  .nav-list a:hover,
  .nav-list a:focus-visible {
    color: var(--gold);
    border-color: rgba(251, 191, 36, 0.3);
    background: rgba(251, 191, 36, 0.06);
    box-shadow: 0 0 12px rgba(251, 191, 36, 0.1);
  }

  @media (max-width: 860px) {
    .header-shell {
      flex-direction: column;
      align-items: stretch;
    }

    .brand {
      justify-content: center;
      text-align: center;
    }

    .nav-list {
      justify-content: center;
    }
  }
</style>
