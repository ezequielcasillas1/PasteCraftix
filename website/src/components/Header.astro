---
import { navItems } from '../data/site.js';

const { currentPath = '/' } = Astro.props;
---

<header class="site-header">
  <div class="container header-shell surface-card">
    <a href="/" class="brand" aria-label="PasteCraft home">
      <img src="/logo.svg" alt="PasteCraft clipboard manager extension" width="42" height="42" class="brand-logo" />
      <span>
        <strong>PasteCraft</strong>
        <small>Clipboard history that stays useful</small>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class:list={{ active: currentPath === item.href }}>
              {item.href === '/scholar-vs-merchant' ? (
                <>
                  <span class="nav-label-full">{item.label}</span>
                  <span class="nav-label-short">Scholar vs Merchant</span>
                </>
              ) : (
                item.label
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding: 1.25rem 0 0;
    position: sticky;
    top: 0;
    z-index: 20;
    max-width: 100%;
  }

  .header-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.84);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 14px 38px -18px rgba(15, 23, 42, 0.25), inset 0 1px 0 #ffffff;
    max-width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    min-width: 0;
    flex: 1 1 auto;
  }

  .brand span {
    min-width: 0;
  }

  .brand-logo {
    border-radius: 12px;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.12);
  }

  .brand strong {
    display: block;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .brand small {
    display: block;
    color: var(--text-muted);
    font-size: 0.78rem;
    margin-top: 0.18rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  nav {
    min-width: 0;
    max-width: 100%;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    justify-content: flex-end;
  }

  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.875rem;
    color: var(--text-soft);
    border: 1px solid transparent;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
    white-space: nowrap;
  }

  .nav-list a.active,
  .nav-list a:hover,
  .nav-list a:focus-visible {
    color: var(--brand);
    border-color: var(--border);
    background: var(--surface-light);
  }

  .nav-label-short {
    display: none;
  }

  @media (max-width: 860px) {
    .header-shell {
      flex-direction: column;
      align-items: stretch;
      border-radius: var(--radius-lg);
      gap: 0.55rem;
      padding: 0.7rem 0.75rem 0.65rem;
    }

    .brand {
      justify-content: center;
      text-align: center;
      flex: 0 0 auto;
    }

    .nav-label-full {
      display: none;
    }

    .nav-label-short {
      display: inline;
    }

    nav {
      margin-inline: -0.15rem;
    }

    .nav-list {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      gap: 0.2rem;
      padding: 0.1rem 0.15rem 0.25rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      mask-image: linear-gradient(90deg, #000 88%, transparent);
    }

    .nav-list::-webkit-scrollbar {
      display: none;
    }

    .nav-list a {
      min-height: 2.25rem;
      padding: 0.4rem 0.7rem;
      font-size: 0.8rem;
      flex: 0 0 auto;
    }
  }

  @media (max-width: 480px) {
    .site-header {
      padding-top: 0.85rem;
    }

    .brand small {
      display: none;
    }

    .brand-logo {
      width: 36px;
      height: 36px;
    }

    .header-shell {
      padding: 0.6rem 0.65rem 0.55rem;
    }

    .nav-list a {
      min-height: 2.15rem;
      padding: 0.35rem 0.6rem;
      font-size: 0.78rem;
    }
  }
</style>
