---
const {
  eyebrow,
  title,
  description,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<section class="hero section">
  <div class="hero-orb orb-1" aria-hidden="true"></div>
  <div class="hero-orb orb-2" aria-hidden="true"></div>
  <div class="hero-orb orb-3" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-grid">
    <div class="stack">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      <p>{description}</p>
      <div class="button-row">
        {primaryHref && primaryLabel && <a class="button" href={primaryHref}>{primaryLabel}</a>}
        {secondaryHref && secondaryLabel && <a class="ghost-button" href={secondaryHref}>{secondaryLabel}</a>}
      </div>
      <slot name="meta" />
    </div>

    <div class="hero-card surface-card">
      <slot />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 3.5rem;
    position: relative;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 500px;
    background:
      radial-gradient(ellipse 60% 80% at 30% 50%, rgba(251, 191, 36, 0.07), transparent),
      radial-gradient(ellipse 70% 60% at 70% 40%, rgba(37, 99, 235, 0.14), transparent);
    pointer-events: none;
    z-index: 0;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    animation: float 8s ease-in-out infinite;
  }

  .orb-1 {
    width: 360px;
    height: 360px;
    top: -80px;
    right: 5%;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.18) 0%, transparent 70%);
    animation-delay: 0s;
  }

  .orb-2 {
    width: 240px;
    height: 240px;
    bottom: 10%;
    left: -60px;
    background: radial-gradient(circle, rgba(251, 191, 36, 0.12) 0%, transparent 70%);
    animation-delay: -3s;
  }

  .orb-3 {
    width: 180px;
    height: 180px;
    top: 40%;
    right: 15%;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.1) 0%, transparent 70%);
    animation-delay: -5s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 1.5rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    max-width: 11ch;
    background: linear-gradient(135deg, #f0f4ff 0%, #93c5fd 50%, var(--gold-light, #fde68a) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  p {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.85;
    color: var(--text-soft);
    max-width: 58ch;
  }

  .hero-card {
    padding: 1.5rem;
    min-height: 100%;
    border: 1px solid rgba(37, 99, 235, 0.3);
    box-shadow: 0 24px 64px rgba(8, 12, 42, 0.5), inset 0 1px 0 rgba(251, 191, 36, 0.08);
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: none;
    }

    .orb-1, .orb-2, .orb-3 {
      display: none;
    }
  }
</style>
