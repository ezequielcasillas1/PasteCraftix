---
const {
  eyebrow,
  title,
  description,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<section class="hero section">
  <div class="container hero-grid">
    <div class="stack">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      <p>{description}</p>
      <div class="button-row">
        {primaryHref && primaryLabel && <a class="button" href={primaryHref}>{primaryLabel}</a>}
        {secondaryHref && secondaryLabel && <a class="ghost-button" href={secondaryHref}>{secondaryLabel}</a>}
      </div>
      <slot name="meta" />
    </div>

    <div class="hero-card surface-card">
      <slot />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 3.5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 1.5rem;
    align-items: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    max-width: 11ch;
  }

  p {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.85;
    color: var(--text-soft);
    max-width: 58ch;
  }

  .hero-card {
    padding: 1.5rem;
    min-height: 100%;
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: none;
    }
  }
</style>
