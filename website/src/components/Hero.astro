---
import { storeLinks } from '../data/site.js';

const bubbles = [
  {
    icon: 'solar:clipboard-check-linear',
    iconClass: 'text-blue-500 bg-blue-50',
    title: 'Clip saved',
    sub: 'Auto-captured from page',
    class: 'bubble-1',
  },
  {
    icon: 'solar:magic-stick-3-linear',
    iconClass: 'text-violet-500 bg-violet-50',
    title: 'Summary ready',
    sub: '18 paragraphs into 5 bullets',
    class: 'bubble-2',
  },
  {
    icon: 'solar:folder-check-linear',
    iconClass: 'text-emerald-500 bg-emerald-50',
    title: 'Filed to Research',
    sub: 'Category auto-suggested',
    class: 'bubble-3',
  },
];
---

<section class="hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <div class="hero-label">
        <span class="hero-label-icon">
          <iconify-icon icon="solar:stars-linear" style="stroke-width: 1.5;"></iconify-icon>
        </span>
        <span>THE CLIPBOARD, CRAFTED</span>
      </div>

      <h1>
        <span class="block">Save everything.</span>
        <span class="block">Find it fast.</span>
        <span class="hero-pill">Paste anywhere.</span>
      </h1>

      <p class="hero-sub">
        PasteCraft turns your clipboard into a crafted library — clips, notes,
        categories, and AI tools that keep everything you copy organized,
        searchable, and ready to reuse.
      </p>

      <div class="hero-ctas">
        <a
          href={storeLinks.chrome}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          Add to Chrome — Free
          <iconify-icon icon="solar:arrow-right-linear" style="stroke-width: 1.5;"></iconify-icon>
        </a>
        <a href="#showcase" class="btn-ghost">
          <iconify-icon icon="solar:play-circle-linear" style="stroke-width: 1.5;" class="ghost-icon"></iconify-icon>
          See How It Works
        </a>
      </div>

      <div class="trust-row">
        <span>
          <iconify-icon icon="solar:shield-check-linear" style="stroke-width: 1.5;"></iconify-icon>
          Private by design
        </span>
        <i></i>
        <span>
          <iconify-icon icon="solar:devices-linear" style="stroke-width: 1.5;"></iconify-icon>
          Chrome + Edge
        </span>
        <i></i>
        <span>
          <iconify-icon icon="solar:bolt-circle-linear" style="stroke-width: 1.5;"></iconify-icon>
          Free forever plan
        </span>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-halo" aria-hidden="true"></div>
      <div class="hero-stage surface-card">
        <slot />
      </div>
      <div class="hero-bubbles" aria-hidden="true">
        {bubbles.map((bubble) => (
          <div class={`float-bubble ${bubble.class}`}>
            <span class={`bubble-icon ${bubble.iconClass}`}>
              <iconify-icon icon={bubble.icon} style="stroke-width: 1.5;"></iconify-icon>
            </span>
            <span class="bubble-text">
              <strong>{bubble.title}</strong>
              <small>{bubble.sub}</small>
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    max-width: 80rem;
    margin: 0 auto;
    padding: 8rem 1.5rem 5rem;
    overflow-x: clip;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: 10rem;
    }
  }

  .hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
      gap: 4rem;
    }
  }

  .hero-copy {
    text-align: center;
    min-width: 0;
    max-width: 100%;
  }

  @media (min-width: 1024px) {
    .hero-copy {
      text-align: left;
    }
  }

  .hero-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid #ffffff;
    padding: 0.5rem 0.875rem;
    box-shadow: 0 6px 18px -12px rgba(15, 23, 42, 0.3), inset 0 1px 0 #ffffff;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    color: #64748b;
  }

  .hero-label-icon {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: linear-gradient(180deg, #eff6ff 0%, #ffffff 100%);
    border: 1px solid #dbeafe;
    box-shadow: inset 0 1px 0 #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue);
    font-size: 1rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 1.1rem + 6.5vw, 6.4rem);
    font-weight: 300;
    letter-spacing: -0.075em;
    line-height: 0.95;
    color: var(--ink);
    text-shadow: 0 1px 1px rgba(255, 255, 255, 0.8);
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  h1 .block {
    display: block;
    white-space: nowrap;
  }

  h1 .block + .block {
    margin-top: 0.5rem;
  }

  .hero-pill {
    display: inline-flex;
    white-space: nowrap;
    margin-top: 1rem;
    max-width: 100%;
    box-sizing: border-box;
    border-radius: 1.35rem;
    background: linear-gradient(180deg, #60a5fa 0%, #2563eb 100%);
    border: 1px solid #1d4ed8;
    padding: 0.375rem 1.25rem 0.625rem;
    color: #ffffff;
    font-weight: 400;
    box-shadow:
      0 18px 38px -20px rgba(59, 130, 246, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.38);
  }

  .hero-sub {
    margin: 2rem auto 0;
    max-width: 42rem;
    font-size: 1rem;
    line-height: 2;
    font-weight: 300;
    color: #475569;
  }

  @media (min-width: 768px) {
    .hero-sub {
      font-size: 1.125rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-sub {
      margin-left: 0;
      margin-right: 0;
    }
  }

  .hero-ctas {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .hero-ctas {
      flex-direction: row;
    }
  }

  @media (min-width: 1024px) {
    .hero-ctas {
      justify-content: flex-start;
    }
  }

  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    border-radius: 999px;
    padding: 0.875rem 1.5rem;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all 300ms ease;
  }

  @media (min-width: 640px) {
    .btn-primary,
    .btn-ghost {
      width: auto;
    }
  }

  .btn-primary {
    background: linear-gradient(180deg, #3b82f6 0%, #2563eb 100%);
    border: 1px solid #1d4ed8;
    color: #ffffff;
    box-shadow: 0 10px 24px rgba(59, 130, 246, 0.26), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .btn-primary:hover {
    background: linear-gradient(180deg, #60a5fa 0%, #3b82f6 100%);
    transform: translateY(-2px);
  }

  .btn-ghost {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border: 1px solid #e2e8f0;
    color: #334155;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05), inset 0 1px 0 #ffffff;
  }

  .btn-ghost:hover {
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    transform: translateY(-2px);
  }

  .ghost-icon {
    color: var(--blue);
    font-size: 1.125rem;
  }

  .trust-row {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    font-weight: 300;
    color: #64748b;
  }

  @media (min-width: 1024px) {
    .trust-row {
      justify-content: flex-start;
    }
  }

  .trust-row span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .trust-row iconify-icon {
    color: var(--blue);
    font-size: 1rem;
  }

  .trust-row i {
    display: none;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 999px;
    background: #cbd5e1;
  }

  @media (min-width: 640px) {
    .trust-row i {
      display: block;
    }
  }

  .hero-visual {
    position: relative;
    min-width: 0;
    max-width: 100%;
    overflow: visible;
  }

  .hero-halo {
    position: absolute;
    inset: 0;
    border-radius: 3rem;
    background: linear-gradient(135deg, rgba(191, 219, 254, 0.4), rgba(255, 255, 255, 0.2), rgba(186, 230, 253, 0.3));
    filter: blur(48px);
    pointer-events: none;
    transform: scale(1.08);
    transform-origin: center;
  }

  .hero-stage {
    position: relative;
    padding: 1.25rem;
    border-radius: 2rem;
    display: flex;
    justify-content: center;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .hero-stage :global(.showcase-card),
  .hero-stage :global(.showcase-card) > div {
    width: 100%;
    max-width: min(100%, 420px);
    min-width: 0;
  }

  .hero-bubbles {
    display: none;
  }

  @media (min-width: 768px) {
    .hero-bubbles {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 20;
      pointer-events: none;
    }
  }

  .float-bubble {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid #ffffff;
    padding: 0.75rem 1rem;
    box-shadow: 0 18px 38px -20px rgba(15, 23, 42, 0.45), inset 0 1px 0 #ffffff;
    min-width: 12rem;
    opacity: 0;
    animation:
      hero-bubble-in 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards,
      hero-float-soft 4.5s ease-in-out infinite;
  }

  .bubble-1 {
    right: max(-0.75rem, -2vw);
    top: 2.5rem;
    animation-delay: 300ms, 1100ms;
  }

  .bubble-2 {
    right: max(-0.75rem, -2vw);
    top: 38%;
    animation-delay: 600ms, 1400ms;
  }

  .bubble-3 {
    left: max(0.5rem, 2vw);
    bottom: -1.5rem;
    animation-delay: 900ms, 1700ms;
  }

  .bubble-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.125rem;
    flex-shrink: 0;
  }

  .bubble-text strong {
    display: block;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--ink-soft);
  }

  .bubble-text small {
    display: block;
    font-size: 0.75rem;
    font-weight: 300;
    color: #94a3b8;
  }

  @keyframes hero-bubble-in {
    0% {
      opacity: 0;
      transform: translateX(18px) translateY(8px) scale(0.96);
      filter: blur(6px);
    }
    100% {
      opacity: 1;
      transform: translateX(0) translateY(0) scale(1);
      filter: blur(0);
    }
  }

  @keyframes hero-float-soft {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 5.5rem 1rem 3.5rem;
    }

    h1 .block,
    .hero-pill {
      white-space: normal;
    }

    .hero-pill {
      display: inline;
      padding: 0.2rem 0.7rem 0.35rem;
      border-radius: 0.95rem;
      line-height: 1.15;
      box-decoration-break: clone;
      -webkit-box-decoration-break: clone;
    }

    .hero-stage {
      padding: 0.5rem 0;
    }

    .hero-label {
      margin-bottom: 1.25rem;
      max-width: 100%;
    }
  }

  @media (max-width: 380px) {
    h1 {
      font-size: clamp(2rem, 9.5vw, 2.6rem);
      letter-spacing: -0.06em;
    }

    .hero-sub {
      font-size: 0.9375rem;
      line-height: 1.75;
    }

    .btn-primary,
    .btn-ghost {
      padding: 0.8rem 1.15rem;
      font-size: 0.8125rem;
    }
  }
</style>
