---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ShowcaseGrid from '../components/showcase/ShowcaseGrid.astro';
import ShowcaseCardClips from '../components/showcase/ShowcaseCard-Clips.astro';
import { pricingPlans, storeLinks } from '../data/site.js';

const problems = [
  {
    icon: 'solar:clipboard-remove-linear',
    title: 'Clips vanish',
    copy: 'Copy something twice and the first thing is gone forever. Your clipboard holds one item and no memory.',
  },
  {
    icon: 'solar:folder-open-linear',
    title: 'Everything lands in one pile',
    copy: 'Code snippets, study quotes, listing drafts — all mixed together with no categories, search, or order.',
  },
  {
    icon: 'solar:rewind-back-linear',
    title: 'You rewrite what you already wrote',
    copy: 'Replies, templates, and answers get typed again and again because there is no reusable library.',
  },
  {
    icon: 'solar:devices-linear',
    title: 'Devices do not share',
    copy: 'What you copy on one machine stays there. Your work does not follow you between browsers or devices.',
  },
];

const workflowSteps = [
  {
    icon: 'solar:copy-linear',
    step: 'Step 01',
    title: 'Copy like you already do',
    copy: 'Ctrl+C stays the same. PasteCraft captures every clip in the background with title, source, and timestamp.',
  },
  {
    icon: 'solar:folder-with-files-linear',
    step: 'Step 02',
    title: 'Craft your library',
    copy: 'File clips into categories, pin what matters, bundle notes and albums, and mark favorites for instant recall.',
  },
  {
    icon: 'solar:stars-linear',
    step: 'Step 03',
    title: 'Reuse in one click',
    copy: 'Quick-paste from the popup or widget, fire AI summaries and breakdowns, and sync it all across Chrome and Edge.',
  },
];

const audiences = [
  {
    href: '/scholar-vs-merchant#scholar',
    icon: 'solar:book-bookmark-linear',
    name: 'Scholar',
    tagline: 'For students, researchers, and deep-work builders.',
    points: [
      'Keep quotes, citations, and sources organized by category',
      'Summarize long reads with AI Lab before you study them',
      'Notes and albums bundle clips into exam-ready packs',
    ],
  },
  {
    href: '/scholar-vs-merchant#merchant',
    icon: 'solar:shop-linear',
    name: 'Merchant',
    comingSoon: true,
    statusLabel: 'Coming soon',
    tagline: 'Coming soon — listing tools for sellers and creators.',
    cta: "See what's coming",
    points: [
      'Stage titles, tags, and descriptions for Etsy, Amazon, and more',
      'Reuse polished replies and promo snippets in one click',
      'Spot-check and strip text before it ships — no per-call AI burn',
    ],
  },
];

const privacyPoints = [
  {
    icon: 'solar:lock-keyhole-linear',
    title: 'Local-first free tier',
    copy: 'Freemium keeps every clip on your device. Nothing leaves the browser unless you choose cloud sync.',
  },
  {
    icon: 'solar:shield-check-linear',
    title: 'Your account, your rows',
    copy: 'Cloud sync stores data in your own account, protected by row-level security. Last-write-wins keeps devices in step.',
  },
  {
    icon: 'solar:trash-bin-trash-linear',
    title: 'Delete means delete',
    copy: 'Remove a clip and it is purged from every synced device. No hidden copies, no dark patterns.',
  },
];

const faqs = [
  {
    q: 'Is PasteCraft a clipboard manager extension?',
    a: 'Yes. It is a clipboard manager extension for Chrome and Edge. Categories, notes, optional cloud sync, and AI Lab are what make it a smart clipboard manager extension — not just a one-item clipboard.',
  },
  {
    q: 'Is PasteCraft really free?',
    a: 'Yes. The Freemium plan includes unlimited clips, notes, and categories with local storage — free forever. Basic adds cloud sync across devices, and Enhanced unlocks AI Lab.',
  },
  {
    q: 'Which browsers does PasteCraft support?',
    a: 'PasteCraft is built for Chrome and Edge. Comet, Brave, and most other Chromium browsers run the same extension. Both stores ship the same build, and cloud sync keeps Chrome and Edge identical.',
  },
  {
    q: 'Do Capture Tools work in every browser?',
    a: 'Image Picker and Spot work on Chrome, Edge, and Comet. They do not work on Opera or Arc. Auto-Copy and click-and-drag still work there — click-and-drag is the capture tool on those browsers.',
  },
  {
    q: 'Where is my data stored?',
    a: 'On Freemium, everything stays on your device. With Basic or Enhanced, clips sync to your private account — each row is protected by row-level security so only you can read it.',
  },
  {
    q: 'What can AI Lab do?',
    a: 'AI Lab turns any clip into summaries, breakdowns, and crafted rewrites. Enhanced plans include weekly, monthly, or yearly text credits with rollover.',
  },
  {
    q: 'Does PasteCraft see what I copy?',
    a: 'No. Capture happens locally in your browser. We never inspect clip contents — sync is account-scoped and you can delete anything permanently.',
  },
  {
    q: 'How do I start?',
    a: 'Install from the Chrome Web Store or Edge Add-ons, pin the extension, and copy something. Your first clip is saved instantly — no account required.',
  },
];
---

<BaseLayout currentPath="/">
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    })}
  />
  <Hero>
    <ShowcaseCardClips />
  </Hero>

  <!-- Problem -->
  <section class="section-block" id="why">
    <div class="section-inner">
      <div class="section-intro">
        <p class="mono-eyebrow">WHY IT MATTERS</p>
        <h2>
          A clipboard manager extension
          <span class="h2-sub">that actually remembers.</span>
        </h2>
        <p class="section-lead">
          Without a clipboard manager, this is what the day usually feels like.
          You copy links, snippets, quotes, and replies — and almost none of it
          stays usable.
        </p>
      </div>
      <div class="problem-grid">
        {problems.map((problem) => (
          <div class="problem-card">
            <div class="icon-tile">
              <iconify-icon icon={problem.icon} style="stroke-width: 1.5;"></iconify-icon>
            </div>
            <h3>{problem.title}</h3>
            <p>{problem.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Showcase: the craft, live -->
  <section class="section-block" id="showcase">
    <div class="section-inner">
      <div class="section-intro center">
        <p class="mono-eyebrow">THE CRAFT, LIVE</p>
        <h2>
          See the workshop
          <span class="h2-sub">right on this page.</span>
        </h2>
        <p class="section-lead center-lead">
          These are the PasteCraft screens, recreated as living mockups.
          Clips, notes, AI Lab, and categories — the same craft you get in the
          extension.
        </p>
      </div>
      <ShowcaseGrid />
      <p class="showcase-disclaimer">
        Mockups of the current iteration — not 100% accurate screenshots of the
        shipping extension.
      </p>
    </div>
  </section>

  <!-- Workflow -->
  <section class="section-block" id="workflow">
    <div class="section-inner">
      <div class="section-intro">
        <p class="mono-eyebrow">HOW IT WORKS</p>
        <h2>
          Copy. Craft.
          <span class="h2-sub">Create.</span>
        </h2>
        <p class="section-lead">
          Three steps, zero new habits. PasteCraft fits the way you already
          work.
        </p>
      </div>
      <div class="workflow-grid">
        {workflowSteps.map((step) => (
          <div class="workflow-card">
            <p class="mono-step">{step.step}</p>
            <div class="icon-tile">
              <iconify-icon icon={step.icon} style="stroke-width: 1.5;"></iconify-icon>
            </div>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Built for -->
  <section class="section-block" id="built-for">
    <div class="section-inner">
      <div class="section-intro">
        <p class="mono-eyebrow">BUILT FOR YOUR CRAFT</p>
        <h2>
          One clipboard,
          <span class="h2-sub">Scholar now. Merchant next.</span>
        </h2>
        <p class="section-lead">
          Scholar is available now for study and deep work.
          PasteCraft Merchant is coming soon for listings and shipping.
        </p>
      </div>
      <div class="audience-grid">
        {audiences.map((audience) => (
          <a href={audience.href} class="audience-card">
            <div class="audience-head">
              <div class="icon-tile">
                <iconify-icon icon={audience.icon} style="stroke-width: 1.5;"></iconify-icon>
              </div>
              <div>
                <div class="audience-title-row">
                  <h3>{audience.name}</h3>
                  {audience.comingSoon && (
                    <span class="coming-soon-badge">{audience.statusLabel}</span>
                  )}
                </div>
                <p class="audience-tagline">{audience.tagline}</p>
              </div>
            </div>
            <ul>
              {audience.points.map((point) => (
                <li>
                  <iconify-icon icon="solar:check-circle-linear" style="stroke-width: 1.5;"></iconify-icon>
                  {point}
                </li>
              ))}
            </ul>
            <span class="audience-link">
              {audience.cta || `Explore ${audience.name}`}
              <iconify-icon icon="solar:arrow-right-linear" style="stroke-width: 1.5;"></iconify-icon>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Privacy (dark contrast section) -->
  <section class="privacy-section" id="privacy">
    <div class="section-inner">
      <div class="section-intro center">
        <p class="mono-eyebrow dark">PRIVACY BY DESIGN</p>
        <h2 class="h2-dark">
          Your clips are yours.
          <span class="h2-sub-dark">Period.</span>
        </h2>
        <p class="section-lead dark-lead center-lead">
          PasteCraft is built so your clipboard stays your business — on your
          device first, and in your private account only when you ask for sync.
        </p>
      </div>
      <div class="privacy-grid">
        {privacyPoints.map((point) => (
          <div class="privacy-card">
            <div class="icon-tile dark-tile">
              <iconify-icon icon={point.icon} style="stroke-width: 1.5;"></iconify-icon>
            </div>
            <h3>{point.title}</h3>
            <p>{point.copy}</p>
          </div>
        ))}
      </div>
      <p class="privacy-link-row">
        <a href="/privacy">Privacy</a>
        <a href="/about">About</a>
        <a href="/support">Support</a>
        <a href="/contact">Contact</a>
      </p>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section-block" id="pricing">
    <div class="section-inner">
      <div class="section-intro center">
        <p class="mono-eyebrow">PRICING</p>
        <h2>
          Start free.
          <span class="h2-sub">Upgrade when it pays off.</span>
        </h2>
        <p class="section-lead center-lead">
          Every plan includes unlimited local clips, notes, and categories.
        </p>
      </div>
      <div class="pricing-grid">
        {pricingPlans.map((plan) => (
          <div class:list={['plan-card', { popular: plan.popular }]}>
            {plan.popular && <span class="popular-badge">Most popular</span>}
            <p class="plan-tier">{plan.tier}</p>
            <p class="plan-price">
              {plan.price}
              <span>{plan.cadence}</span>
            </p>
            <p class="plan-note">{plan.note}</p>
            <ul>
              {plan.features.slice(0, 5).map((feature) => (
                <li>
                  <iconify-icon icon="solar:check-circle-linear" style="stroke-width: 1.5;"></iconify-icon>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="pricing-link-row">
        <a href="/pricing" class="btn-text">
          Compare full plans
          <iconify-icon icon="solar:arrow-right-linear" style="stroke-width: 1.5;"></iconify-icon>
        </a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-block" id="faq">
    <div class="section-inner narrow-inner">
      <div class="section-intro center">
        <p class="mono-eyebrow">QUESTIONS</p>
        <h2>
          Answers, before
          <span class="h2-sub">you ask.</span>
        </h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>
              <h3>{faq.q}</h3>
              <iconify-icon icon="solar:alt-arrow-down-linear" style="stroke-width: 1.5;" class="faq-chevron"></iconify-icon>
            </summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section-block final-cta">
    <div class="section-inner narrow-inner center">
      <h2>
        Craft your clipboard.
        <span class="h2-sub">It takes one copy.</span>
      </h2>
      <p class="section-lead center-lead">
        Install PasteCraft free on Chrome or Edge. Your first clip saves
        instantly — no account needed.
      </p>
      <div class="final-ctas">
        <a href={storeLinks.chrome} target="_blank" rel="noopener noreferrer" class="btn-primary-lg">
          Add to Chrome
          <iconify-icon icon="solar:arrow-right-linear" style="stroke-width: 1.5;"></iconify-icon>
        </a>
        <a href={storeLinks.edge} target="_blank" rel="noopener noreferrer" class="btn-ghost-lg">
          Get it on Edge
        </a>
      </div>
    </div>
  </section>

  <script>
    import { createCardDither } from '../features/starfield/create-card-dither.js';

    document.querySelectorAll('.showcase-card').forEach((card) => {
      if (card instanceof HTMLElement) createCardDither(card);
    });
  </script>
</BaseLayout>

<style>
  .section-block {
    margin: 0 auto;
    padding: 5rem 1.5rem;
    box-sizing: border-box;
    max-width: min(80rem, 100%);
    overflow-x: clip;
  }

  .section-inner,
  .narrow-inner {
    min-width: 0;
    max-width: 100%;
  }

  .narrow-inner {
    max-width: 56rem;
    margin: 0 auto;
  }

  .center {
    text-align: center;
  }

  .section-intro {
    max-width: 48rem;
    margin-bottom: 4rem;
  }

  .section-intro.center {
    margin-left: auto;
    margin-right: auto;
  }

  .mono-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--blue);
    margin: 0 0 1rem;
  }

  .mono-eyebrow.dark {
    color: var(--blue-soft);
  }

  h2 {
    margin: 0;
    font-size: clamp(1.85rem, 1.2rem + 3.2vw, 3.75rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--ink);
    overflow-wrap: break-word;
  }

  .h2-sub {
    display: block;
    color: var(--ink);
  }

  .h2-dark {
    color: #ffffff;
  }

  .h2-sub-dark {
    display: block;
    color: var(--blue-soft);
  }

  .section-lead {
    margin: 1.25rem 0 0;
    font-size: 1rem;
    line-height: 2;
    font-weight: 300;
    color: #475569;
    max-width: 42rem;
  }

  @media (min-width: 768px) {
    .section-lead {
      font-size: 1.125rem;
    }
  }

  .center-lead {
    margin-left: auto;
    margin-right: auto;
  }

  .dark-lead {
    color: #94a3b8;
  }

  .icon-tile {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 1rem;
    background: var(--blue-faint);
    border: 1px solid #dbeafe;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue);
    font-size: 1.5rem;
    box-shadow: inset 0 1px 0 #ffffff;
    flex-shrink: 0;
  }

  .dark-tile {
    background: rgba(59, 130, 246, 0.12);
    border-color: rgba(147, 197, 253, 0.25);
    color: var(--blue-soft);
    box-shadow: none;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .problem-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .problem-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .problem-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.62);
    border: 1px solid #ffffff;
    padding: 1.5rem;
    box-shadow: 0 10px 28px -20px rgba(15, 23, 42, 0.24), inset 0 1px 0 #ffffff;
    transition: all 300ms ease;
    min-width: 0;
  }

  .problem-card:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.82);
  }

  .problem-card h3,
  .workflow-card h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .problem-card p,
  .workflow-card p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.75;
    font-weight: 300;
    color: #475569;
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .workflow-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .workflow-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-radius: 2rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 1.75rem;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03), inset 0 1px 0 #ffffff;
    transition: all 300ms ease;
    min-width: 0;
  }

  .workflow-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px -26px rgba(15, 23, 42, 0.25), inset 0 1px 0 #ffffff;
  }

  .mono-step {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #94a3b8;
    letter-spacing: -0.05em;
    margin: 0;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .audience-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .audience-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-radius: 2rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 2rem;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03), inset 0 1px 0 #ffffff;
    transition: all 300ms ease;
    min-width: 0;
  }

  .audience-card:hover {
    transform: translateY(-4px);
    border-color: #bfdbfe;
    box-shadow: 0 18px 38px -20px rgba(59, 130, 246, 0.25), inset 0 1px 0 #ffffff;
  }

  .audience-head {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .audience-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .audience-head h3 {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .coming-soon-badge {
    display: inline-flex;
    width: fit-content;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #b45309;
    border: 1px solid #fcd34d;
    background: rgba(251, 191, 36, 0.16);
  }

  .audience-tagline {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    font-weight: 300;
    color: #64748b;
  }

  .audience-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  .audience-card li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.875rem;
    font-weight: 300;
    color: #475569;
    line-height: 1.6;
  }

  .audience-card li iconify-icon {
    color: var(--blue);
    font-size: 1rem;
    margin-top: 0.2rem;
    flex-shrink: 0;
  }

  .audience-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--brand);
    font-weight: 400;
  }

  .privacy-section {
    background: linear-gradient(180deg, #020617 0%, #0f172a 100%);
    padding: 6rem 1.5rem;
    box-sizing: border-box;
    overflow-x: clip;
  }

  .privacy-section .section-inner {
    max-width: min(80rem, 100%);
    margin: 0 auto;
    min-width: 0;
  }

  .privacy-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .privacy-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .privacy-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.75rem;
  }

  .privacy-card h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .privacy-card p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.75;
    font-weight: 300;
    color: #94a3b8;
  }

  .privacy-link-row {
    margin: 3rem 0 0;
    text-align: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem 1.25rem;
  }

  .privacy-link-row a {
    color: var(--blue-soft);
    font-size: 0.875rem;
    text-decoration: none;
    border-bottom: 1px solid rgba(147, 197, 253, 0.4);
    padding-bottom: 2px;
    transition: color 200ms ease;
  }

  .privacy-link-row a:hover {
    color: #ffffff;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
