---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionShell from '../components/SectionShell.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingCard from '../components/PricingCard.astro';
import Preview3D from '../components/Preview3D.astro';
import { pricingPlans, storeLinks, trustPills } from '../data/site.js';

const featureItems = [
  {
    icon: '⚡',
    title: 'Copy fast, save what matters',
    copy: 'Capture valuable text in seconds—study material, research, and notes you need again—then paste it back without hunting through tabs.',
  },
  {
    icon: '🧭',
    title: 'Categories and notes in one flow',
    copy: 'Move through clips, categories, and notes so productive study sessions stay organized instead of scattered.',
  },
  {
    icon: '✨',
    title: 'AI Lab for real situations',
    copy: 'Use AI Lab for summaries, breakdowns, and study-ready help when a dense page, lecture note, or work draft needs clarity.',
  },
];

const testimonials = [
  {
    name: 'Sarah M.',
    role: 'Graduate student',
    avatar: 'https://i.pravatar.cc/64?img=1',
    quote: 'I copy research all day. PasteCraft saves what I need for exams, keeps it in categories, and makes review much faster.',
  },
  {
    name: 'James K.',
    role: 'Software engineer',
    avatar: 'https://i.pravatar.cc/64?img=3',
    quote: 'AI Lab helps when docs get dense. I save snippets fast, organize them, and get back to shipping with less friction.',
  },
  {
    name: 'Priya L.',
    role: 'Productivity coach',
    avatar: 'https://i.pravatar.cc/64?img=5',
    quote: 'PasteCraft fits study and work habits. Fast copy, clear notes, and categories that keep valuable information ready to reuse.',
  },
];

const counterStats = [
  { value: 10000, suffix: '+', label: 'Clips saved', prefix: '' },
  { value: 500, suffix: '+', label: 'Active users', prefix: '' },
  { value: 190, suffix: '+', label: 'Languages', prefix: '' },
  { value: 4.8, suffix: '★', label: 'Average rating', prefix: '' },
];
---

<BaseLayout
  title="PasteCraft | Productivity and study clipboard for Edge and Chrome"
  description="PasteCraft is a productivity and study tool that helps you copy fast, save valuable information, organize categories and notes, and use AI Lab when you need clarity. Free to start on Chrome and Edge."
  keywords="clipboard manager, study tool, productivity extension, clipboard history, chrome extension, edge extension, study notes, categories, AI Lab, copy paste tool, text snippets, cloud sync clipboard"
  currentPath="/"
>
  <Hero
    eyebrow="Productivity and study tool"
    title="Copy fast, save what matters"
    description="PasteCraft helps you save the information you need most—valuable notes, research, and study material—so you can copy quickly and get back to work. Organize clips into categories and notes, then use AI Lab when a situation calls for it."
    primaryHref={storeLinks.chrome}
    primaryLabel="Install for Chrome"
    secondaryHref={storeLinks.edge}
    secondaryLabel="Install for Edge"
  >
    <div class="hero-stack">
      <div class="hero-matrix">
        <div class="hero-panel surface-card panel">
          <span class="hero-label">Fast capture</span>
          <strong>Save valuable information quickly</strong>
          <p>Keep study material, research, and work notes ready to paste when you need them.</p>
        </div>
        <div class="hero-panel surface-card panel accent">
          <span class="hero-label">Study-wise flow</span>
          <strong>Categories, notes, and AI Lab</strong>
          <p>Orchestrate copying, saving, and review—then open AI Lab for almost any situation.</p>
        </div>
      </div>

      <div class="browser-pills">
        <a class="pill pill-live" href={storeLinks.chrome} target="_blank" rel="noopener noreferrer">
          <span class="pill-dot"></span>
          Chrome — Live
        </a>
        <a class="pill pill-live" href={storeLinks.edge} target="_blank" rel="noopener noreferrer">
          <span class="pill-dot"></span>
          Edge — Live
        </a>
      </div>
    </div>

    <Fragment slot="meta">
      <div class="tag-row">
        {trustPills.map((pill) => (
          <span class="tag">{pill}</span>
        ))}
      </div>
    </Fragment>
  </Hero>

  <section class="section stats-section" id="stats">
    <div class="container">
      <div class="stats-counter-grid">
        {counterStats.map((stat) => (
          <div class="counter-card surface-card panel">
            <strong class="counter-number" data-target={stat.value} data-suffix={stat.suffix} data-prefix={stat.prefix}>
              {stat.prefix}{stat.value.toLocaleString()}{stat.suffix}
            </strong>
            <span class="counter-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionShell
    eyebrow="Features"
    title="Built for productivity and studying habits"
    copy="PasteCraft turns fast copying into a lasting workflow. Save what matters, organize it, and reuse it when you study or work."
  >
    <FeatureGrid items={featureItems} />
  </SectionShell>

  <section class="section mockup-section">
    <div class="container">
      <div class="mockup-shell">
        <div class="mockup-text stack">
          <span class="eyebrow">Extension preview</span>
          <h2 class="section-title">See the study and work flow in your browser</h2>
          <p class="section-copy">Copy text, open PasteCraft, and find it saved, organized, and ready to paste into your next study session or productivity sprint.</p>
          <div class="button-row">
            <a class="button" href={storeLinks.chrome} target="_blank" rel="noopener noreferrer">Install for Chrome</a>
            <a class="ghost-button" href={storeLinks.edge} target="_blank" rel="noopener noreferrer">Install for Edge</a>
          </div>
        </div>
        <Preview3D />
      </div>
    </div>
  </section>

  <SectionShell
    eyebrow="Workflow"
    title="Orchestrate copy, save, and review"
    copy="PasteCraft keeps the moves that matter close together so you spend less time hunting and more time learning or shipping."
  >
    <div class="split">
      <article class="surface-card panel stack">
        <h3>Save the information you need</h3>
        <ul class="list-clean">
          <li>Capture study material, research, and work notes the moment you copy them.</li>
          <li>Keep valuable information ready instead of losing it to a temporary clipboard.</li>
          <li>Paste quickly when a deadline, lecture, or task needs the right detail.</li>
        </ul>
      </article>

      <article class="surface-card panel stack">
        <h3>Move with categories, notes, and AI Lab</h3>
        <ul class="list-clean">
          <li>Sort clips into categories so review stays structured.</li>
          <li>Use notes to keep context next to the content that matters.</li>
          <li>Open AI Lab for summaries and breakdowns in almost any situation.</li>
        </ul>
      </article>
    </div>
  </SectionShell>

  <section class="section testimonials-section">
    <div class="container">
      <div class="section-header stack">
        <span class="eyebrow">What users say</span>
        <h2 class="section-title">Built for people who study and ship</h2>
      </div>
      <div class="testimonials-grid">
        {testimonials.map((t) => (
          <article class="testimonial-card surface-card panel">
            <div class="testimonial-stars">★★★★★</div>
            <p class="testimonial-quote">"{t.quote}"</p>
            <div class="testimonial-author">
              <img src={t.avatar} alt={t.name} width="40" height="40" class="testimonial-avatar" loading="lazy" />
              <div>
                <strong>{t.name}</strong>
                <span>{t.role}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <SectionShell
    eyebrow="Plans"
    title="Choose a plan that fits your habits"
    copy="Start free for fast local capture. Add cloud sync for continuity, or unlock AI Lab when study and work need deeper help."
  >
    <div class="card-grid three">
      {pricingPlans.map((plan) => (
        <PricingCard
          id={`${plan.id}-home`}
          name={plan.name}
          tier={plan.tier}
          price={plan.price}
          cadence={plan.cadence}
          note={plan.note}
          features={plan.features}
          popular={plan.popular}
        >
          <a class={plan.popular ? 'button' : 'ghost-button'} href="/pricing">View pricing</a>
        </PricingCard>
      ))}
    </div>
  </SectionShell>

  <script is:inline>
    try {
      var _hashParams = new URLSearchParams((window.location.hash || '').substring(1));
      if (
        _hashParams.get('type') === 'recovery' ||
        _hashParams.get('access_token') ||
        _hashParams.get('error_description')
      ) {
        window.location.replace('/reset-password' + (window.location.hash || ''));
      }
    } catch (_) {}
  </script>

  <script is:inline>
    (function () {
      var counters = document.querySelectorAll('.counter-number');
      if (!counters.length) return;

      function animateCounter(el) {
        var target = parseFloat(el.dataset.target);
        var suffix = el.dataset.suffix || '';
        var prefix = el.dataset.prefix || '';
        var duration = 1800;
        var start = performance.now();
        var isDecimal = target % 1 !== 0;

        function step(now) {
          var elapsed = now - start;
          var progress = Math.min(elapsed / duration, 1);
          var eased = 1 - Math.pow(1 - progress, 3);
          var current = target * eased;
          el.textContent = prefix + (isDecimal ? current.toFixed(1) : Math.floor(current).toLocaleString()) + suffix;
          if (progress < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              animateCounter(entry.target);
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.3 });
        counters.forEach(function (el) { observer.observe(el); });
      } else {
        counters.forEach(animateCounter);
      }
    })();
  </script>

  <SectionShell
    eyebrow="Get started"
    title="Ready to copy fast and study with clarity"
    copy="Install PasteCraft on Chrome or Edge. Subscribe from inside the extension after you install."
  >
    <div class="surface-card panel cta-band">
      <div class="stack">
        <h3>Start free, then grow into sync and AI Lab</h3>
        <p class="section-copy">Get the Chrome Web Store or Edge Add-ons listing, then finish checkout inside the extension after install.</p>
      </div>
      <div class="button-row">
        <a class="button" href={storeLinks.chrome} target="_blank" rel="noopener noreferrer">Install for Chrome</a>
        <a class="ghost-button" href={storeLinks.edge} target="_blank" rel="noopener noreferrer">Install for Edge</a>
        <a class="ghost-button" href="/pricing">View pricing</a>
      </div>
    </div>
  </SectionShell>

  <style>
    .hero-stack {
      display: grid;
      gap: 1rem;
    }

    .hero-matrix {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .hero-panel strong {
      display: block;
      margin: 0.45rem 0 0.75rem;
      font-size: 1.2rem;
    }

    .hero-panel p {
      margin: 0;
      color: var(--text-soft);
      line-height: 1.7;
    }

    .hero-label {
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 0.72rem;
      font-weight: 700;
    }

    .accent {
      background:
        linear-gradient(180deg, rgba(251, 191, 36, 0.1) 0%, rgba(8, 12, 42, 0) 100%),
        var(--surface);
      border-color: rgba(251, 191, 36, 0.2);
    }

    .browser-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.45rem 0.85rem;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 600;
    }

    .pill-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
    }

    .pill-live {
      background: rgba(37, 99, 235, 0.12);
      border: 1px solid rgba(37, 99, 235, 0.4);
      color: #93c5fd;
      text-decoration: none;
    }

    .pill-live:hover {
      border-color: rgba(37, 99, 235, 0.7);
      color: #bfdbfe;
    }

    .pill-live .pill-dot {
      background: #22d3ee;
      box-shadow: 0 0 6px #22d3ee;
      animation: pulse-dot 2s ease-in-out infinite;
    }

    .pill-soon {
      background: rgba(251, 191, 36, 0.08);
      border: 1px solid rgba(251, 191, 36, 0.3);
      color: var(--gold);
    }

    .pill-soon .pill-dot {
      background: var(--gold);
      opacity: 0.6;
    }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    .stats-section {
      padding: 2rem 0 3rem;
    }

    .stats-counter-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .counter-card {
      text-align: center;
      border: 1px solid rgba(37, 99, 235, 0.25);
      transition: transform 200ms ease, border-color 200ms ease;
    }

    .counter-card:hover {
      transform: translateY(-3px);
      border-color: rgba(251, 191, 36, 0.3);
    }

    .counter-number {
      display: block;
      font-size: 2.4rem;
      font-weight: 800;
      line-height: 1;
      margin-bottom: 0.5rem;
      background: var(--gradient-gold);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .counter-label {
      color: var(--text-muted);
      font-size: 0.88rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .mockup-section {
      background: linear-gradient(180deg, transparent 0%, rgba(13, 18, 64, 0.4) 50%, transparent 100%);
    }

    .mockup-shell {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    .mockup-shell :global(.preview-3d) {
      justify-self: end;
    }

    .testimonials-section {
      padding: 4.5rem 0;
    }

    .section-header {
      margin-bottom: 2.5rem;
    }

    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .testimonial-card {
      display: grid;
      gap: 1rem;
      border: 1px solid rgba(37, 99, 235, 0.22);
      backdrop-filter: blur(20px);
      background:
        linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(13, 18, 64, 0.6) 100%),
        var(--surface);
      transition: transform 200ms ease, border-color 200ms ease;
    }

    .testimonial-card:hover {
      transform: translateY(-4px);
      border-color: rgba(251, 191, 36, 0.3);
    }

    .testimonial-stars {
      color: var(--gold);
      font-size: 0.95rem;
      letter-spacing: 0.05em;
    }

    .testimonial-quote {
      margin: 0;
      color: var(--text-soft);
      line-height: 1.75;
      font-style: italic;
    }

    .testimonial-author {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .testimonial-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 2px solid rgba(251, 191, 36, 0.3);
      flex-shrink: 0;
    }

    .testimonial-author strong {
      display: block;
      font-size: 0.92rem;
    }

    .testimonial-author span {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .cta-band {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border: 1px solid rgba(251, 191, 36, 0.2);
      background:
        linear-gradient(135deg, rgba(251, 191, 36, 0.05) 0%, rgba(37, 99, 235, 0.08) 100%),
        var(--surface);
    }

    .cta-band h3 {
      margin: 0;
      font-size: 1.5rem;
    }

    @media (max-width: 980px) {
      .hero-matrix,
      .stats-counter-grid,
      .testimonials-grid,
      .mockup-shell {
        grid-template-columns: 1fr;
      }

      .mockup-shell :global(.preview-3d) {
        justify-self: center;
      }

      .cta-band {
        flex-direction: column;
        align-items: stretch;
      }
    }
  </style>
</BaseLayout>
