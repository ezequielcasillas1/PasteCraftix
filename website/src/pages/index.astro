---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionShell from '../components/SectionShell.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingCard from '../components/PricingCard.astro';
import Preview3D from '../components/Preview3D.astro';
import { pricingPlans, trustPills } from '../data/site.js';

const featureItems = [
  {
    icon: '🧭',
    title: 'Clarity-first organization',
    copy: 'Turn messy clipboard chaos into clean categories, searchable notes, and a workspace that feels intentional.',
  },
  {
    icon: '☁️',
    title: 'Cloud sync when you need it',
    copy: 'Start local, then move up to synced storage across devices without changing the way you already work.',
  },
  {
    icon: '✨',
    title: 'Readable AI assistance',
    copy: 'Use summaries, breakdowns, and image tools only when they help, with a product experience that stays calm and usable.',
  },
];

const testimonials = [
  {
    name: 'Sarah M.',
    role: 'UX Researcher',
    avatar: 'https://i.pravatar.cc/64?img=1',
    quote: 'PasteCraft completely replaced my old clipboard workflow. The categories and cloud sync are exactly what I needed for cross-device research.',
  },
  {
    name: 'James K.',
    role: 'Software Engineer',
    avatar: 'https://i.pravatar.cc/64?img=3',
    quote: 'The AI breakdown feature saves me so much time parsing docs and code snippets. Clean UI, no friction — it just works.',
  },
  {
    name: 'Priya L.',
    role: 'Content Strategist',
    avatar: 'https://i.pravatar.cc/64?img=5',
    quote: 'I copy a LOT of stuff every day. PasteCraft makes it all findable and usable. The free plan alone is already better than anything else I tried.',
  },
];

const counterStats = [
  { value: 10000, suffix: '+', label: 'Clips saved', prefix: '' },
  { value: 500, suffix: '+', label: 'Active users', prefix: '' },
  { value: 190, suffix: '+', label: 'Languages', prefix: '' },
  { value: 4.8, suffix: '★', label: 'Average rating', prefix: '' },
];
---

<BaseLayout
  title="PasteCraft | Best Clipboard Manager & History Extension for Chrome & Edge"
  description="PasteCraft is the best clipboard manager and history tool for Chrome and Edge. Save unlimited clips, organize with categories, sync across devices, and unlock AI-powered features. Free to start."
  keywords="clipboard manager, clipboard history, chrome extension, edge extension, clipboard organizer, cloud sync clipboard, copy paste tool, text snippets, AI clipboard, productivity tool, best clipboard manager"
  currentPath="/"
>
  <Hero
    eyebrow="Designed from the PasteCraft mark"
    title="A clipboard manager that finally feels premium."
    description="PasteCraft helps you keep every clip readable, organized, and ready to reuse. Save locally, sync across devices, and unlock AI-powered assistance only when it actually improves your flow."
    primaryHref="/pricing"
    primaryLabel="Explore pricing"
    secondaryHref="/about"
    secondaryLabel="Why PasteCraft"
  >
    <div class="hero-stack">
      <div class="hero-matrix">
        <div class="hero-panel surface-card panel">
          <span class="hero-label">Quick capture</span>
          <strong>Save everything you copy.</strong>
          <p>Keep plain text, notes, snippets, and research in a single polished system.</p>
        </div>
        <div class="hero-panel surface-card panel accent">
          <span class="hero-label">Readable design</span>
          <strong>Built around the PasteCraft palette.</strong>
          <p>Deep navy, rich gold, and soft glass surfaces make dense information easier to scan.</p>
        </div>
      </div>

      <div class="browser-pills">
        <span class="pill pill-live">
          <span class="pill-dot"></span>
          Edge — Live Now
        </span>
        <span class="pill pill-soon">
          <span class="pill-dot"></span>
          Chrome — Coming Soon
        </span>
      </div>
    </div>

    <Fragment slot="meta">
      <div class="tag-row">
        {trustPills.map((pill) => (
          <span class="tag">{pill}</span>
        ))}
      </div>
    </Fragment>
  </Hero>

  <section class="section stats-section" id="stats">
    <div class="container">
      <div class="stats-counter-grid">
        {counterStats.map((stat) => (
          <div class="counter-card surface-card panel">
            <strong class="counter-number" data-target={stat.value} data-suffix={stat.suffix} data-prefix={stat.prefix}>
              {stat.prefix}{stat.value.toLocaleString()}{stat.suffix}
            </strong>
            <span class="counter-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionShell
    eyebrow="What changes"
    title="The upgrade from copy-and-paste to pastecrafting"
    copy="The product is designed to work for students, researchers, coders, and busy operators who need more from copied information than a temporary clipboard can offer."
  >
    <FeatureGrid items={featureItems} />
  </SectionShell>

  <section class="section mockup-section">
    <div class="container">
      <div class="mockup-shell">
        <div class="mockup-text stack">
          <span class="eyebrow">Extension preview</span>
          <h2 class="section-title">See it in action</h2>
          <p class="section-copy">A focused panel right in your browser. Copy something, open PasteCraft, and it's already there — organized, searchable, and ready.</p>
          <div class="button-row">
            <a class="button" href="/pricing">Get started free</a>
            <a class="ghost-button" href="/about">Learn more</a>
          </div>
        </div>
        <Preview3D />
      </div>
    </div>
  </section>

  <SectionShell
    eyebrow="Why it reads better"
    title="Made to reduce friction, not add spectacle."
    copy="The new visual system uses the logo's own tones to create a calmer reading surface for dense content, settings, pricing, and support flows."
  >
    <div class="split">
      <article class="surface-card panel stack">
        <h3>Readable by default</h3>
        <ul class="list-clean">
          <li>Clearer typography scale with less visual noise.</li>
          <li>Better spacing rhythm between actions, labels, and explanations.</li>
          <li>Stronger contrast across navigation, cards, and legal content.</li>
        </ul>
      </article>

      <article class="surface-card panel stack">
        <h3>Built for reliability</h3>
        <ul class="list-clean">
          <li>Static-first marketing pages for fast delivery and easy maintenance.</li>
          <li>Preserved pricing, upgrade, and account flows where behavior matters.</li>
          <li>Cleaner shared components instead of page-by-page style duplication.</li>
        </ul>
      </article>
    </div>
  </SectionShell>

  <section class="section testimonials-section">
    <div class="container">
      <div class="section-header stack">
        <span class="eyebrow">What users say</span>
        <h2 class="section-title">Built for people who copy a lot</h2>
      </div>
      <div class="testimonials-grid">
        {testimonials.map((t) => (
          <article class="testimonial-card surface-card panel">
            <div class="testimonial-stars">★★★★★</div>
            <p class="testimonial-quote">"{t.quote}"</p>
            <div class="testimonial-author">
              <img src={t.avatar} alt={t.name} width="40" height="40" class="testimonial-avatar" loading="lazy" />
              <div>
                <strong>{t.name}</strong>
                <span>{t.role}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <SectionShell
    eyebrow="Plans"
    title="Choose the level that fits your workflow"
    copy="Start free, move to synced storage, or unlock the full AI-assisted experience when your workload grows."
  >
    <div class="card-grid three">
      {pricingPlans.map((plan) => (
        <PricingCard
          id={`${plan.id}-home`}
          name={plan.name}
          tier={plan.tier}
          price={plan.price}
          cadence={plan.cadence}
          note={plan.note}
          features={plan.features}
          popular={plan.popular}
        >
          <a class={plan.popular ? 'button' : 'ghost-button'} href="/pricing">View details</a>
        </PricingCard>
      ))}
    </div>
  </SectionShell>

  <script is:inline>
    try {
      var _hashParams = new URLSearchParams((window.location.hash || '').substring(1));
      if (
        _hashParams.get('type') === 'recovery' ||
        _hashParams.get('access_token') ||
        _hashParams.get('error_description')
      ) {
        window.location.replace('/reset-password' + (window.location.hash || ''));
      }
    } catch (_) {}
  </script>

  <script is:inline>
    (function () {
      var counters = document.querySelectorAll('.counter-number');
      if (!counters.length) return;

      function animateCounter(el) {
        var target = parseFloat(el.dataset.target);
        var suffix = el.dataset.suffix || '';
        var prefix = el.dataset.prefix || '';
        var duration = 1800;
        var start = performance.now();
        var isDecimal = target % 1 !== 0;

        function step(now) {
          var elapsed = now - start;
          var progress = Math.min(elapsed / duration, 1);
          var eased = 1 - Math.pow(1 - progress, 3);
          var current = target * eased;
          el.textContent = prefix + (isDecimal ? current.toFixed(1) : Math.floor(current).toLocaleString()) + suffix;
          if (progress < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              animateCounter(entry.target);
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.3 });
        counters.forEach(function (el) { observer.observe(el); });
      } else {
        counters.forEach(animateCounter);
      }
    })();
  </script>

  <SectionShell
    eyebrow="Ready when you are"
    title="Bring better structure to every copied idea"
    copy="Whether you stay on the free plan or subscribe inside the extension, PasteCraft is built to keep your clipboard history more useful, more legible, and more durable."
  >
    <div class="surface-card panel cta-band">
      <div class="stack">
        <h3>See the plans, compare the tiers, and subscribe when it fits.</h3>
        <p class="section-copy">You can explore everything from the pricing page and finish subscription flows inside the extension experience.</p>
      </div>
      <div class="button-row">
        <a class="button" href="/pricing">Open pricing</a>
        <a class="ghost-button" href="/account">Go to account</a>
      </div>
    </div>
  </SectionShell>

  <style>
    .hero-stack {
      display: grid;
      gap: 1rem;
    }

    .hero-matrix {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .hero-panel strong {
      display: block;
      margin: 0.45rem 0 0.75rem;
      font-size: 1.2rem;
    }

    .hero-panel p {
      margin: 0;
      color: var(--text-soft);
      line-height: 1.7;
    }

    .hero-label {
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 0.72rem;
      font-weight: 700;
    }

    .accent {
      background:
        linear-gradient(180deg, rgba(251, 191, 36, 0.1) 0%, rgba(8, 12, 42, 0) 100%),
        var(--surface);
      border-color: rgba(251, 191, 36, 0.2);
    }

    .browser-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.45rem 0.85rem;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 600;
    }

    .pill-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
    }

    .pill-live {
      background: rgba(37, 99, 235, 0.12);
      border: 1px solid rgba(37, 99, 235, 0.4);
      color: #93c5fd;
    }

    .pill-live .pill-dot {
      background: #22d3ee;
      box-shadow: 0 0 6px #22d3ee;
      animation: pulse-dot 2s ease-in-out infinite;
    }

    .pill-soon {
      background: rgba(251, 191, 36, 0.08);
      border: 1px solid rgba(251, 191, 36, 0.3);
      color: var(--gold);
    }

    .pill-soon .pill-dot {
      background: var(--gold);
      opacity: 0.6;
    }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    .stats-section {
      padding: 2rem 0 3rem;
    }

    .stats-counter-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .counter-card {
      text-align: center;
      border: 1px solid rgba(37, 99, 235, 0.25);
      transition: transform 200ms ease, border-color 200ms ease;
    }

    .counter-card:hover {
      transform: translateY(-3px);
      border-color: rgba(251, 191, 36, 0.3);
    }

    .counter-number {
      display: block;
      font-size: 2.4rem;
      font-weight: 800;
      line-height: 1;
      margin-bottom: 0.5rem;
      background: var(--gradient-gold);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .counter-label {
      color: var(--text-muted);
      font-size: 0.88rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .mockup-section {
      background: linear-gradient(180deg, transparent 0%, rgba(13, 18, 64, 0.4) 50%, transparent 100%);
    }

    .mockup-shell {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    .testimonials-section {
      padding: 4.5rem 0;
    }

    .section-header {
      margin-bottom: 2.5rem;
    }

    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .testimonial-card {
      display: grid;
      gap: 1rem;
      border: 1px solid rgba(37, 99, 235, 0.22);
      backdrop-filter: blur(20px);
      background:
        linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(13, 18, 64, 0.6) 100%),
        var(--surface);
      transition: transform 200ms ease, border-color 200ms ease;
    }

    .testimonial-card:hover {
      transform: translateY(-4px);
      border-color: rgba(251, 191, 36, 0.3);
    }

    .testimonial-stars {
      color: var(--gold);
      font-size: 0.95rem;
      letter-spacing: 0.05em;
    }

    .testimonial-quote {
      margin: 0;
      color: var(--text-soft);
      line-height: 1.75;
      font-style: italic;
    }

    .testimonial-author {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .testimonial-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 2px solid rgba(251, 191, 36, 0.3);
      flex-shrink: 0;
    }

    .testimonial-author strong {
      display: block;
      font-size: 0.92rem;
    }

    .testimonial-author span {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .cta-band {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border: 1px solid rgba(251, 191, 36, 0.2);
      background:
        linear-gradient(135deg, rgba(251, 191, 36, 0.05) 0%, rgba(37, 99, 235, 0.08) 100%),
        var(--surface);
    }

    .cta-band h3 {
      margin: 0;
      font-size: 1.5rem;
    }

    @media (max-width: 980px) {
      .hero-matrix,
      .stats-counter-grid,
      .testimonials-grid,
      .mockup-shell {
        grid-template-columns: 1fr;
      }

      .cta-band {
        flex-direction: column;
        align-items: stretch;
      }
    }
  </style>
</BaseLayout>
