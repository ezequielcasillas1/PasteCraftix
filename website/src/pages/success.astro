---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Payment Successful | PasteCraft"
  description="Your PasteCraft subscription is active. Open the extension and start using premium features."
  currentPath="/success"
>
  <div class="page-shell">
    <section class="section">
      <div class="container narrow">
        <article class="surface-card success-shell">
          <div class="success-icon" aria-hidden="true">✓</div>
          <span class="eyebrow">Subscription active</span>
          <h1>Welcome to PasteCraft Premium</h1>
          <p class="section-copy">Your payment went through successfully. Open the browser extension and your upgraded access should be ready automatically.</p>

          <div class="success-box">
            <strong>What you can do now</strong>
            <ol>
              <li>Open the PasteCraft extension from your browser toolbar.</li>
              <li>Visit your account or premium tools.</li>
              <li>Start using synced storage and AI-enabled features based on your plan.</li>
            </ol>
          </div>

          <div class="button-row">
            <a class="button" href="/">Return home</a>
            <a class="ghost-button" href="/account">Open account page</a>
          </div>
        </article>
      </div>
    </section>
  </div>

  <style>
    .success-shell {
      padding: 2rem;
      text-align: center;
      display: grid;
      gap: 1rem;
    }

    .success-shell h1 {
      margin: 0;
      font-size: clamp(2.5rem, 7vw, 4rem);
      line-height: 1;
    }

    .success-icon {
      width: 5rem;
      height: 5rem;
      margin: 0 auto;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, #68d391 0%, #2f855a 100%);
      color: #03140d;
      font-size: 2.2rem;
      font-weight: 900;
      box-shadow: 0 18px 42px rgba(47, 133, 90, 0.3);
    }

    .success-box {
      text-align: left;
      border-radius: var(--radius-md);
      border: 1px solid rgba(104, 211, 145, 0.25);
      background: rgba(104, 211, 145, 0.08);
      padding: 1.25rem;
    }

    .success-box strong {
      display: block;
      margin-bottom: 0.8rem;
    }

    .success-box ol {
      margin: 0;
      padding-left: 1.2rem;
      color: var(--text-soft);
      line-height: 1.8;
    }
  </style>
</BaseLayout>
