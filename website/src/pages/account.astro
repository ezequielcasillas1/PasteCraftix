---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout currentPath="/account">
  <script is:inline slot="head" src="/lib/supabase.min.js"></script>

  <div class="page-shell">
    <section class="section">
      <div class="container">
        <div class="split">
          <article class="surface-card panel stack intro-card">
            <span class="eyebrow">Account</span>
            <h1>Manage your PasteCraft plan and profile.</h1>
            <p class="section-copy">Sign in to view your subscription tier, account settings, and product status in one cleaner dashboard.</p>
            <div class="tag-row">
              <span class="tag">Secure auth</span>
              <span class="tag">Plan visibility</span>
              <span class="tag">Preference controls</span>
            </div>
          </article>

          <article class="surface-card panel auth-card" id="authContainer">
            <div class="stack">
              <span class="eyebrow">Sign in</span>
              <h2>Access your account</h2>
              <p class="section-copy">Use the same email and password you use inside the extension.</p>
            </div>

            <div class="error-message" id="errorMessage"></div>

            <form id="signInForm" class="stack form-shell">
              <label class="field">
                <span>Email</span>
                <input type="email" id="email" required placeholder="you@example.com" />
              </label>
              <label class="field">
                <span>Password</span>
                <input type="password" id="password" required placeholder="••••••••" />
              </label>
              <button class="button" type="submit">Sign in</button>
              <div class="forgot-row">
                <button class="link-button" id="forgotPasswordBtn" type="button" title="Sends a reset link to your email" aria-label="Forgot password">
                  Forgot password?
                </button>
              </div>
              <div class="forgot-status" id="forgotPasswordStatus"></div>
            </form>

            <div class="auth-divider"><span>or</span></div>

            <div class="stack magic-link-block">
              <p class="section-copy magic-link-copy">No password? No problem. We'll email you a secure one-tap sign-in link.</p>
              <button class="ghost-button" id="sendMagicLinkBtn" type="button">Email me a sign-in link</button>
              <div class="magic-link-status" id="magicLinkStatus"></div>
            </div>
          </article>
        </div>

        <section class="dashboard" id="dashboard">
          <article class="surface-card panel dashboard-header">
            <div class="stack">
              <span class="eyebrow">Dashboard</span>
              <h2 id="userName">Welcome back!</h2>
              <p class="section-copy" id="userEmail"></p>
            </div>

            <div class="dashboard-actions">
              <span class="subscription-badge" id="subscriptionBadge">FREE</span>
              <button class="ghost-button" id="signOutBtn" type="button">Sign out</button>
            </div>
          </article>

          <div class="stats-row">
            <article class="stat surface-card">
              <strong id="totalClips">--</strong>
              <span>Total clips</span>
            </article>
            <article class="stat surface-card">
              <strong id="totalCategories">--</strong>
              <span>Categories</span>
            </article>
            <article class="stat surface-card">
              <strong id="totalArchived">--</strong>
              <span>Archived</span>
            </article>
            <article class="stat surface-card">
              <strong>Sync</strong>
              <span>Subscription-aware account state</span>
            </article>
          </div>

          <div class="card-grid two dashboard-grid">
            <article class="surface-card panel stack">
              <div class="coupon-notification" id="couponNotification">
                <span class="coupon-label">Special access</span>
                <span class="coupon-code-badge" id="couponCodeBadge">ACTIVE</span>
              </div>

              <h3>Subscription status</h3>
              <p class="section-copy" id="subscriptionStatus">You are currently on the Free plan.</p>
              <button class="button" id="upgradeButton" type="button" data-action="go-pricing">Upgrade to Premium</button>
            </article>

            <article class="surface-card panel stack">
              <h3>Account settings</h3>
              <p class="section-copy">Update your email, reset your password, or save your email preference for product updates.</p>

              <div class="stack field-group">
                <label class="field">
                  <span>Email address</span>
                  <input type="email" id="newEmailInput" placeholder="new@example.com" autocomplete="email" />
                </label>
                <button class="ghost-button" id="changeEmailBtn" type="button">Update email</button>
                <div class="email-change-status" id="emailChangeStatus"></div>
              </div>

              <label class="toggle">
                <input type="checkbox" id="marketingOptIn" />
                <span>Send me product and improvement updates</span>
              </label>
              <div class="button-row">
                <button class="ghost-button" id="sendPasswordResetBtn" type="button" title="Resets password" aria-label="Resets password">Send password reset email</button>
                <button class="button" id="savePreferencesBtn" type="button">Save preferences</button>
              </div>
              <div class="settings-status" id="settingsStatus"></div>
            </article>
          </div>
        </section>
      </div>
    </section>
  </div>

  <!-- External script: CSP on /account* is script-src 'self' (blocks inline). -->
  <script is:inline src="/js/account-auth.js"></script>

  <style>
    .intro-card h1 {
      margin: 0;
      font-size: clamp(2.4rem, 6vw, 4.2rem);
      line-height: 0.98;
    }

    .auth-card {
      padding: 1.5rem;
    }

    .auth-card h2,
    .dashboard-header h2 {
      margin: 0;
      font-size: 1.8rem;
    }

    .form-shell {
      margin-top: 1rem;
    }

    .field {
      display: grid;
      gap: 0.55rem;
    }

    .field span {
      color: var(--text-soft);
      font-size: 0.95rem;
    }

    .field input {
      width: 100%;
      min-height: 3.25rem;
      padding: 0.9rem 1rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border);
      background: rgba(162, 207, 212, 0.05);
      color: var(--text);
    }

    .error-message {
      display: none;
      margin-top: 1rem;
      padding: 0.85rem 1rem;
      border-radius: var(--radius-sm);
      border: 1px solid rgba(254, 178, 178, 0.28);
      background: rgba(254, 178, 178, 0.08);
      color: #feb2b2;
    }

    .dashboard {
      display: none;
      margin-top: 1.5rem;
    }

    .dashboard.active {
      display: grid;
      gap: 1rem;
    }

    .dashboard-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .dashboard-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .subscription-badge {
      display: inline-flex;
      align-items: center;
      min-height: 2.5rem;
      padding: 0.6rem 0.95rem;
      border-radius: 999px;
      background: rgba(162, 207, 212, 0.1);
      border: 1px solid var(--border);
      color: var(--brand-soft);
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 0.75rem;
    }

    .subscription-badge.premium {
      background: rgba(235, 180, 65, 0.14);
      color: var(--accent);
    }

    .subscription-badge.basic {
      background: rgba(53, 117, 160, 0.18);
      color: #dff0f3;
    }

    .subscription-badge.free {
      background: rgba(162, 207, 212, 0.08);
      color: var(--brand-soft);
    }

    .dashboard-grid {
      margin-top: 1rem;
    }

    .coupon-notification {
      display: none;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.85rem 1rem;
      border-radius: var(--radius-sm);
      border: 1px solid rgba(235, 180, 65, 0.28);
      background: rgba(235, 180, 65, 0.08);
    }

    .coupon-notification.show {
      display: flex;
    }

    .coupon-label {
      color: var(--text-soft);
    }

    .coupon-code-badge {
      padding: 0.45rem 0.75rem;
      border-radius: 999px;
      background: rgba(235, 180, 65, 0.18);
      color: var(--accent);
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-size: 0.72rem;
    }

    .toggle {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      color: var(--text-soft);
    }

    .toggle input {
      width: 1.1rem;
      height: 1.1rem;
    }

    .settings-status,
    .magic-link-status,
    .email-change-status {
      display: none;
      min-height: 1.5rem;
      font-weight: 600;
      font-size: 0.9rem;
    }

    .auth-divider {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 1.25rem 0 0.5rem;
      color: var(--text-muted);
      font-size: 0.85rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .auth-divider::before,
    .auth-divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: linear-gradient(
        90deg,
        rgba(162, 207, 212, 0) 0%,
        rgba(162, 207, 212, 0.22) 50%,
        rgba(162, 207, 212, 0) 100%
      );
    }

    .magic-link-block {
      gap: 0.75rem;
    }

    .magic-link-copy {
      font-size: 0.92rem;
      color: var(--text-soft);
    }

    .field-group {
      gap: 0.75rem;
      padding-bottom: 0.25rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 0.25rem;
    }

    .forgot-row {
      display: flex;
      justify-content: flex-end;
      margin-top: -0.25rem;
    }

    .link-button {
      background: none;
      border: none;
      padding: 0;
      color: var(--brand-soft);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: underline;
      text-decoration-color: rgba(162, 207, 212, 0.35);
      text-underline-offset: 3px;
      transition: color 0.15s ease, text-decoration-color 0.15s ease;
    }

    .link-button:hover {
      color: var(--accent);
      text-decoration-color: var(--accent);
    }

    .forgot-status {
      display: none;
      min-height: 1.25rem;
      font-weight: 600;
      font-size: 0.9rem;
    }
  </style>
</BaseLayout>
