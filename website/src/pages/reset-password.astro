---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout currentPath="/reset-password">
  <script is:inline slot="head" src="/lib/supabase.min.js"></script>

  <div class="page-shell">
    <section class="section">
      <div class="container narrow">
        <div class="reset-grid">
          <article class="surface-card panel stack reset-info">
            <span class="eyebrow">Password reset</span>
            <h1>Set your new PasteCraft password on the website.</h1>
            <p class="section-copy">
              This page handles the final password change. Once you save the new password,
              return to the PasteCraft widget and sign in normally.
            </p>
            <ul class="list-clean">
              <li>Minimum 8 characters</li>
              <li>At least one lowercase letter</li>
              <li>At least one uppercase letter</li>
              <li>At least one digit from 0-9</li>
              <li>At least one symbol such as !@#$%^&*</li>
            </ul>
          </article>

          <article class="surface-card panel stack reset-card">
            <span class="eyebrow" id="resetEyebrow">Checking link</span>
            <h2 id="resetTitle">Checking your reset link...</h2>
            <p class="section-copy" id="resetCopy">
              Validating your recovery session and preparing the password form.
            </p>

            <div class="status-banner info" id="resetStatus">
              Processing your reset link.
            </div>

            <form id="resetForm" class="stack form-shell" hidden>
              <label class="field">
                <span>New password</span>
                <input
                  type="password"
                  id="newPassword"
                  required
                  placeholder="Create a strong password"
                  autocomplete="new-password"
                />
              </label>

              <div class="field-meta">
                <span id="passwordCharCount">0 characters</span>
                <span id="passwordStrengthLabel">Waiting for input</span>
              </div>

              <div class="password-strength" id="passwordStrength">
                <div class="strength-bar"></div>
              </div>

              <div class="password-allowance">
                Use letters, numbers 0-9, and symbols such as
                <code>! @ # $ % ^ &amp; * ( ) _ + - = [ ] &#123; &#125; ; : " | , . &lt; &gt; / ?</code>. The password must include at
                least one lowercase letter, uppercase letter, number, and symbol.
              </div>

              <div class="password-requirements">
                <div class="password-requirements-title">Password requirements</div>
                <div class="requirement-item" id="req-length">
                  <span class="requirement-icon">✗</span>
                  <span>At least 8 characters</span>
                </div>
                <div class="requirement-item" id="req-lowercase">
                  <span class="requirement-icon">✗</span>
                  <span>Contains a lowercase letter (a-z)</span>
                </div>
                <div class="requirement-item" id="req-uppercase">
                  <span class="requirement-icon">✗</span>
                  <span>Contains an uppercase letter (A-Z)</span>
                </div>
                <div class="requirement-item" id="req-number">
                  <span class="requirement-icon">✗</span>
                  <span>Contains a digit (0-9)</span>
                </div>
                <div class="requirement-item" id="req-special">
                  <span class="requirement-icon">✗</span>
                  <span>Contains a symbol like !@#$%^&amp;*</span>
                </div>
              </div>

              <label class="field">
                <span>Confirm new password</span>
                <input
                  type="password"
                  id="confirmPassword"
                  required
                  placeholder="Re-enter your password"
                  autocomplete="new-password"
                />
              </label>

              <div class="input-hint" id="passwordMatchHint" hidden></div>

              <button class="button" type="submit" id="resetSubmitBtn" disabled>
                Update password
              </button>
            </form>

            <div class="success-panel" id="resetSuccess" hidden>
              <h3>Password updated successfully</h3>
              <p>
                Your new password is ready. Return to the PasteCraft widget login screen and
                sign in with the updated password.
              </p>
              <div class="button-row">
                <a class="button" href="/account">Back to account</a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>

  <!-- External script: CSP on /reset-password* is script-src 'self' (blocks inline). -->
  <script is:inline src="/js/reset-password.js"></script>

  <style>
    /* .stack sets display:grid and overrides native [hidden] — restore hide behavior */
    [hidden] {
      display: none !important;
    }

    .reset-grid {
      display: grid;
      grid-template-columns: 0.95fr 1.05fr;
      gap: 1.5rem;
      align-items: start;
    }

    .reset-info h1,
    .reset-card h2,
    .success-panel h3 {
      margin: 0;
    }

    .form-shell {
      margin-top: 0.5rem;
    }

    .field {
      display: grid;
      gap: 0.55rem;
    }

    .field span {
      color: var(--text-soft);
      font-size: 0.95rem;
    }

    .field input {
      width: 100%;
      min-height: 3.25rem;
      padding: 0.9rem 1rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border);
      background: rgba(162, 207, 212, 0.05);
      color: var(--text);
    }

    .field-meta {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      color: var(--text-muted);
      font-size: 0.92rem;
    }

    .status-banner {
      padding: 0.95rem 1rem;
      border-radius: var(--radius-sm);
      border: 1px solid transparent;
      font-weight: 600;
    }

    .status-banner.info {
      color: var(--text);
      border-color: var(--border);
      background: rgba(162, 207, 212, 0.08);
    }

    .status-banner.success {
      color: #d1fae5;
      border-color: rgba(16, 185, 129, 0.35);
      background: rgba(16, 185, 129, 0.14);
    }

    .status-banner.error {
      color: #fecaca;
      border-color: rgba(239, 68, 68, 0.35);
      background: rgba(239, 68, 68, 0.12);
    }

    .password-strength {
      width: 100%;
      height: 0.5rem;
      border-radius: 999px;
      background: rgba(162, 207, 212, 0.12);
      overflow: hidden;
    }

    .strength-bar {
      width: 0;
      height: 100%;
      border-radius: inherit;
      background: #ef4444;
      transition: width 160ms ease, background 160ms ease;
    }

    .password-allowance {
      padding: 0.95rem 1rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border);
      background: rgba(162, 207, 212, 0.05);
      color: var(--text-soft);
      font-size: 0.95rem;
      line-height: 1.65;
    }

    .password-allowance code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 0.9em;
      color: var(--text);
    }

    .password-requirements {
      display: grid;
      gap: 0.7rem;
      padding: 1rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border);
      background: rgba(162, 207, 212, 0.05);
    }

    .password-requirements-title {
      font-weight: 700;
      color: var(--text);
    }

    .requirement-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: var(--text-soft);
    }

    .requirement-item.met {
      color: #86efac;
    }

    .requirement-icon {
      width: 1.25rem;
      text-align: center;
      font-weight: 800;
    }

    .input-hint {
      font-size: 0.92rem;
      color: var(--text-muted);
    }

    .input-hint.match-ok {
      color: #86efac;
    }

    .input-hint.match-bad {
      color: #fca5a5;
    }

    .success-panel {
      display: grid;
      gap: 1rem;
      padding: 1rem;
      border-radius: var(--radius-sm);
      border: 1px solid rgba(16, 185, 129, 0.28);
      background: rgba(16, 185, 129, 0.08);
    }

    .success-panel p {
      margin: 0;
      color: var(--text-soft);
      line-height: 1.7;
    }

    @media (max-width: 900px) {
      .reset-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
