---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/SectionShell.astro';

const principles = [
  'Readable interfaces beat crowded dashboards.',
  'Clipboard history should stay useful after you copy.',
  'AI should help when it helps, not take over the workflow.',
  'Free users should get a strong product, not a limited demo.',
];
---

<BaseLayout
  title="About PasteCraft"
  description="Learn why PasteCraft exists and how it approaches clipboard management, sync, and optional AI tools with a readability-first mindset."
  currentPath="/about"
>
  <div class="page-shell">
    <SectionShell
      eyebrow="About PasteCraft"
      title="Built for people who copy a lot and hate losing context"
      copy="PasteCraft makes copied information durable. Instead of a temporary scratchpad, you get a place to organize, revisit, and reuse what you copy."
    >
      <div class="split">
        <article class="surface-card panel stack">
          <h3>Our story</h3>
          <p class="section-copy">Too many useful snippets vanish right after you copy them. Research notes, code fragments, messages, and study material deserve a cleaner place to land.</p>
        </article>
        <article class="surface-card panel stack">
          <h3>Our mission</h3>
          <p class="section-copy">Make clipboard management calm, capable, and readable across free, synced, and AI-assisted workflows.</p>
        </article>
      </div>
    </SectionShell>

    <SectionShell
      eyebrow="Principles"
      title="How we shape the product"
      copy="A few product rules keep PasteCraft focused."
    >
      <div class="card-grid two">
        {principles.map((principle) => (
          <article class="surface-card panel">
            <p class="section-copy">{principle}</p>
          </article>
        ))}
      </div>
    </SectionShell>

    <SectionShell
      eyebrow="What makes it different"
      title="A middle ground between simple history and bloated workspaces"
      copy="PasteCraft stays light on day one, then grows into sync, categories, notes, and premium tools when you need them."
    >
      <div class="card-grid three">
        <article class="surface-card panel stack">
          <h3>Useful at every tier</h3>
          <p class="section-copy">The free experience is strong enough for daily use.</p>
        </article>
        <article class="surface-card panel stack">
          <h3>Sync when it matters</h3>
          <p class="section-copy">Cloud-backed workflows stay available when you need continuity across devices.</p>
        </article>
        <article class="surface-card panel stack">
          <h3>AI as an upgrade</h3>
          <p class="section-copy">Breakdowns, summaries, and image tools sit on top of the core workflow instead of replacing it.</p>
        </article>
      </div>
    </SectionShell>
  </div>
</BaseLayout>
