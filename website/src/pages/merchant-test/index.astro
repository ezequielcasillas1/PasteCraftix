---
import BaseLayout from '../../layouts/BaseLayout.astro';

const mockPages = [
  { href: '/merchant-test/etsy.html', label: 'Etsy', preset: '13×20', tests: 'Tag queue, materials, snippets, alt text, Seal & Ship' },
  { href: '/merchant-test/printify.html', label: 'Printify', preset: '20×40', tests: 'Preset switch, tag queue, variant stub' },
  { href: '/merchant-test/shopify.html', label: 'Shopify', preset: '250×255', tests: 'Tags + SEO fields' },
  { href: '/merchant-test/amazon.html', label: 'Amazon', preset: '30×50', tests: 'Bullets + backend keywords' },
  { href: '/merchant-test/ebay.html', label: 'eBay', preset: '12×65', tests: 'Item specifics key-value' },
  { href: '/merchant-test/redbubble.html', label: 'Redbubble', preset: '15×39', tests: 'Tag validation chips' },
  { href: '/merchant-test/teepublic.html', label: 'TeePublic', preset: '32×255', tests: 'Large tag grid' },
  { href: '/merchant-test/woocommerce.html', label: 'WooCommerce', preset: '250×255', tests: 'Product tags' },
  { href: '/merchant-test/generic.html', label: 'Generic', preset: '30×50', tests: 'Custom max, listing pack' },
  { href: '/merchant-test/social-promo.html', label: 'Social promo', preset: 'Promo', tests: 'Hashtags + caption' },
];
---

<BaseLayout
  title="Merchant Test Lab | PasteCraft"
  description="Mock seller listing pages for PasteCraft Merchant extension QA and DOM adapter development."
  currentPath="/merchant-test.html"
>
  <div class="container lab-page">
    <p class="eyebrow">Dev / QA</p>
    <h1>Merchant Test Lab</h1>
    <p class="lead">
      Crude mock shop forms for manual Merchant QA. Load the unpacked extension, open a mock page, and exercise strip actions.
    </p>

    <section class="surface-card panel">
      <h2>Quick setup</h2>
      <ol>
        <li>Load extension from <code>extension/</code> in Chrome/Edge</li>
        <li>Open any mock page below</li>
        <li>Verify Merchant strip, Listing Dock, Tag Queue, Materials, Snippets</li>
      </ol>
    </section>

    <section class="surface-card panel">
      <h2>Mock pages</h2>
      <table class="mock-table">
        <thead>
          <tr>
            <th>Platform</th>
            <th>Preset</th>
            <th>What to test</th>
          </tr>
        </thead>
        <tbody>
          {mockPages.map((page) => (
            <tr>
              <td><a href={page.href}>{page.label}</a></td>
              <td>{page.preset}</td>
              <td>{page.tests}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>
</BaseLayout>

<style>
  .lab-page {
    padding: 2rem 0 4rem;
    max-width: 820px;
  }

  .eyebrow {
    color: var(--gold);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.5rem;
  }

  h1 {
    margin: 0 0 0.75rem;
  }

  .lead {
    color: var(--text-soft);
    margin: 0 0 2rem;
    line-height: 1.7;
  }

  .panel {
    padding: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .panel h2 {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    color: var(--gold);
  }

  .panel ol {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--text-soft);
    line-height: 1.8;
  }

  code {
    font-size: 0.9em;
    color: var(--gold);
  }

  .mock-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .mock-table th,
  .mock-table td {
    border: 1px solid rgba(251, 191, 36, 0.15);
    padding: 0.65rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .mock-table th {
    color: var(--gold);
    font-weight: 600;
  }

  .mock-table a {
    color: var(--gold);
    font-weight: 600;
    text-decoration: none;
  }

  .mock-table a:hover {
    text-decoration: underline;
  }

  .mock-table td:last-child {
    color: var(--text-soft);
  }
</style>
