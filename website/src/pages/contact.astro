---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/SectionShell.astro';
import BlueskyLink from '../components/BlueskyLink.astro';
---

<BaseLayout currentPath="/contact">
  <div class="page-shell">
    <SectionShell
      eyebrow="Updates"
      headingLevel={1}
      title="Follow PasteCraft on Bluesky"
      copy="Product news and questions go through our Bluesky profile."
    >
      <article class="surface-card panel stack align-center">
        <BlueskyLink class="button" />
      </article>
    </SectionShell>
  </div>
</BaseLayout>

<style>
  .align-center {
    align-items: center;
    text-align: center;
    max-width: 28rem;
    margin: 0 auto;
  }
</style>
