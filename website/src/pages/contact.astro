---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/SectionShell.astro';
---

<BaseLayout
  title="Contact PasteCraft"
  description="Reach the PasteCraft team for support, feedback, privacy questions, or legal requests."
  currentPath="/contact"
>
  <div class="page-shell">
    <SectionShell
      eyebrow="Contact"
      title="Reach the right inbox quickly"
      copy="Whether you need product support, want to report a billing issue, or have a privacy question, the easiest path is to contact the mailbox that matches your request."
    >
      <div class="card-grid three">
        <article class="surface-card panel stack">
          <h3>Support</h3>
          <p class="section-copy">Questions about the extension, pricing, syncing, or premium access.</p>
          <a class="ghost-button" href="mailto:support@pastecraft.com">support@pastecraft.com</a>
        </article>
        <article class="surface-card panel stack">
          <h3>Privacy</h3>
          <p class="section-copy">Requests related to data handling, deletion, or privacy concerns.</p>
          <a class="ghost-button" href="mailto:privacy@pastecraft.com">privacy@pastecraft.com</a>
        </article>
        <article class="surface-card panel stack">
          <h3>Legal</h3>
          <p class="section-copy">Terms, policy questions, or formal legal requests.</p>
          <a class="ghost-button" href="mailto:legal@pastecraft.com">legal@pastecraft.com</a>
        </article>
      </div>
    </SectionShell>

    <SectionShell
      eyebrow="Response expectations"
      title="What to include for faster help"
      copy="A short message with the browser you use, your plan tier, and what went wrong makes it much easier for us to respond accurately."
    >
      <div class="split">
        <article class="surface-card panel">
          <ul class="list-clean">
            <li>Your browser and version if known.</li>
            <li>Whether you are on Freemium, Basic, or Enhanced.</li>
            <li>What page or feature you were using.</li>
            <li>A screenshot or short description of the issue.</li>
          </ul>
        </article>

        <article class="surface-card panel stack">
          <h3>Community links</h3>
          <p class="section-copy">You can also follow product updates and join the conversation through the official community channels.</p>
          <div class="button-row">
            <a class="ghost-button" href="https://www.facebook.com/PasteCraftOfficial" target="_blank" rel="noopener">Facebook</a>
            <a class="ghost-button" href="https://www.reddit.com/r/PasteCraft/" target="_blank" rel="noopener">Reddit</a>
          </div>
        </article>
      </div>
    </SectionShell>
  </div>
</BaseLayout>
