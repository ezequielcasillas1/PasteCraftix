---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/SectionShell.astro';
---

<BaseLayout currentPath="/contact">
  <div class="page-shell">
    <SectionShell
      eyebrow="Contact"
      headingLevel={1}
      title="Reach the right inbox"
      copy="Use the mailbox that matches your request for support, privacy, or legal questions."
    >
      <div class="card-grid three">
        <article class="surface-card panel stack">
          <h3>Support</h3>
          <p class="section-copy">Questions about the extension, pricing, sync, or premium access.</p>
          <a class="ghost-button" href="mailto:support@pastecraft.com">support@pastecraft.com</a>
        </article>
        <article class="surface-card panel stack">
          <h3>Privacy</h3>
          <p class="section-copy">Requests about data handling, deletion, or privacy concerns.</p>
          <a class="ghost-button" href="mailto:privacy@pastecraft.com">privacy@pastecraft.com</a>
        </article>
        <article class="surface-card panel stack">
          <h3>Legal</h3>
          <p class="section-copy">Terms, policy questions, or formal legal requests.</p>
          <a class="ghost-button" href="mailto:legal@pastecraft.com">legal@pastecraft.com</a>
        </article>
      </div>
    </SectionShell>

    <SectionShell
      eyebrow="Faster help"
      title="What to include in your message"
      copy="Share your browser, plan tier, and what went wrong so we can respond accurately."
    >
      <div class="split">
        <article class="surface-card panel">
          <ul class="list-clean">
            <li>Your browser and version if known.</li>
            <li>Whether you are on Freemium, Basic, or Enhanced.</li>
            <li>What page or feature you were using.</li>
            <li>A screenshot or short description of the issue.</li>
          </ul>
        </article>

        <article class="surface-card panel stack">
          <h3>Community</h3>
          <p class="section-copy">Follow product updates and join the conversation on official channels.</p>
          <div class="button-row">
            <a class="ghost-button" href="https://www.facebook.com/PasteCraftOfficial" target="_blank" rel="noopener noreferrer">Facebook</a>
            <a class="ghost-button" href="https://www.reddit.com/r/PasteCraft/" target="_blank" rel="noopener noreferrer">Reddit</a>
          </div>
        </article>
      </div>
    </SectionShell>
  </div>
</BaseLayout>
