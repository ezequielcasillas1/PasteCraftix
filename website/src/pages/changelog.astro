---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/SectionShell.astro';
import { changelogIntro, changelogReleases, changelogEras } from '../data/changelog.js';

const formatDate = (iso) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
---

<BaseLayout currentPath="/changelog">
  <div class="page-shell changelog">
    <section class="page-header">
      <div class="container stack">
        <span class="eyebrow">{changelogIntro.eyebrow}</span>
        <h1 class="section-title">{changelogIntro.title}</h1>
        <p class="section-copy">{changelogIntro.copy}</p>
        <nav class="changelog-jump" aria-label="On this page">
          <a href="/">Home</a>
          <a href="#releases">Store versions</a>
          <a href="#eras">Earlier history</a>
        </nav>
      </div>
    </section>

    <div id="releases">
      <SectionShell
        eyebrow="Store versions"
        title="What shipped in each release"
        copy="Newest first. When Chrome and Edge differ, availability is on the release card."
      >
        <ol class="changelog-list">
          {changelogReleases.map((release) => (
            <li class="surface-card changelog-card">
              <div class="changelog-meta">
                <span class="version-badge">{release.version}</span>
                <time datetime={release.date}>{formatDate(release.date)}</time>
              </div>
              {release.stores?.length ? (
                <ul class="store-status" aria-label={`${release.version} store availability`}>
                  {release.stores.map((store) => (
                    <li>
                      <span class:list={['store-badge', store.status]}>{store.label}</span>
                    </li>
                  ))}
                </ul>
              ) : null}
              <h2>{release.title}</h2>
              {release.availability ? <p class="section-copy store-availability">{release.availability}</p> : null}
              <ul class="list-clean">
                {release.highlights.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </SectionShell>
    </div>

    <div id="eras">
      <SectionShell
        eyebrow="Product eras"
        title="How PasteCraft grew"
        copy="Larger feature waves that landed around those versions — Scholar tools, Merchant, Blue Dark Mode, and the original clip library."
      >
        <div class="card-grid two">
          {changelogEras.map((era) => (
            <article class="surface-card changelog-card" id={era.id}>
              <h2>{era.title}</h2>
              <p class="section-copy">{era.summary}</p>
              <ul class="list-clean">
                {era.highlights.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </SectionShell>
    </div>
  </div>
</BaseLayout>

<style>
  .changelog-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.35rem;
  }

  .changelog-jump a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--text-soft);
    font-size: 0.88rem;
    background: rgba(59, 130, 246, 0.06);
  }

  .changelog-jump a:hover,
  .changelog-jump a:focus-visible {
    color: var(--brand);
    border-color: #bfdbfe;
  }

  .changelog-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .changelog-card {
    padding: 1.35rem 1.45rem;
    display: grid;
    gap: 0.75rem;
  }

  .changelog-card h2 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .changelog-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .changelog-meta time {
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .version-badge {
    display: inline-flex;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    border: 1px solid #bfdbfe;
    background: rgba(59, 130, 246, 0.1);
    color: var(--brand);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .store-status {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .store-badge {
    display: inline-flex;
    padding: 0.24rem 0.65rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .store-badge.live {
    border: 1px solid #86efac;
    background: rgba(22, 163, 74, 0.12);
    color: #166534;
  }

  .store-badge.pending {
    border: 1px solid #fcd34d;
    background: rgba(217, 119, 6, 0.12);
    color: #92400e;
  }

  .store-availability {
    margin: 0;
  }
</style>
