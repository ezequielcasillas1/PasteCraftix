---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/SectionShell.astro';
import PricingCard from '../components/PricingCard.astro';
import { pricingPlans, storeLinks } from '../data/site.js';

const [, basicPlan, enhancedPlan] = pricingPlans;
---

<BaseLayout
  title="Upgrade to Premium | PasteCraft"
  description="Unlock synced storage and AI-powered PasteCraft features with a cleaner, more readable upgrade page."
  currentPath="/upgrade"
>
  <div class="page-shell">
    <SectionShell
      eyebrow="Premium access"
      title="You found a feature worth upgrading for."
      copy="PasteCraft keeps the core workflow light, then layers premium capabilities on top when you want more sync, more power, or more AI assistance."
    >
      <div class="stack">
        <div class="feature-attempted surface-card panel" id="featureAttempted" style="display:none;">
          <span class="feature-icon" id="featureIcon">✨</span>
          <div>
            <strong>Feature preview</strong>
            <p id="featureName" class="section-copy">Premium Feature</p>
          </div>
        </div>

        <div class="card-grid three">
          <article class="surface-card panel stack">
            <h3>AI breakdowns</h3>
            <p class="section-copy">Translate dense text into clearer explanations across different comprehension levels.</p>
          </article>
          <article class="surface-card panel stack">
            <h3>AI summaries</h3>
            <p class="section-copy">Condense clipboard content quickly when you need the key points, not the full wall of text.</p>
          </article>
          <article class="surface-card panel stack">
            <h3>Image generation</h3>
            <p class="section-copy">Unlock image-based premium tools without changing the core clipboard workflow.</p>
          </article>
        </div>
      </div>
    </SectionShell>

    <SectionShell
      eyebrow="Choose your tier"
      title="Subscribe inside the extension after install"
      copy="The current upgrade flow is designed to begin from your signed-in PasteCraft extension so the subscription stays tied to the correct account."
    >
      <div class="card-grid two">
        <PricingCard
          id="upgrade-basic"
          name={basicPlan.name}
          tier={basicPlan.tier}
          price={basicPlan.price}
          cadence={basicPlan.cadence}
          note={basicPlan.note}
          features={basicPlan.features}
          billing={basicPlan.billing}
          dataPlan="basic"
        >
          <div class="button-row">
            <a href={storeLinks.chrome} class="button btn-store" data-store="chrome">Chrome</a>
            <a href={storeLinks.edge} class="ghost-button btn-store" data-store="edge">Edge</a>
          </div>
          <span class="muted">Subscribe within the extension.</span>
        </PricingCard>

        <PricingCard
          id="upgrade-enhanced"
          name={enhancedPlan.name}
          tier={enhancedPlan.tier}
          price={enhancedPlan.price}
          cadence={enhancedPlan.cadence}
          note={enhancedPlan.note}
          features={enhancedPlan.features}
          popular={true}
          billing={enhancedPlan.billing}
          dataPlan="enhanced"
        >
          <div class="button-row">
            <a href={storeLinks.chrome} class="button btn-store" data-store="chrome">Chrome</a>
            <a href={storeLinks.edge} class="ghost-button btn-store" data-store="edge">Edge</a>
          </div>
          <span class="muted">Unlock AI and sync together.</span>
        </PricingCard>
      </div>

      <article class="surface-card panel notice">
        <h3>Already have the extension?</h3>
        <p class="section-copy">Close this page, open PasteCraft from your browser toolbar, and use the upgrade action from your profile to continue.</p>
      </article>
    </SectionShell>
  </div>

  <script is:inline>
    const featureData = {
      breakdown: { icon: '🧠', name: 'AI Breakdown' },
      summary: { icon: '✨', name: 'AI Summary' },
      image: { icon: '🎨', name: 'AI Image Generation' },
      avatar: { icon: '🐾', name: 'AI Animal Avatar' },
      cartoon: { icon: '🎭', name: 'AI Cartoon Generator' },
      name: { icon: '📝', name: 'AI Name Generator' },
      gallery: { icon: '🖼️', name: 'AI Gallery' },
    };

    const urlParams = new URLSearchParams(window.location.search);
    const feature = urlParams.get('feature');

    if (feature) {
      const data = featureData[feature] || { icon: '✨', name: 'Premium Feature' };
      const wrapper = document.getElementById('featureAttempted');
      const icon = document.getElementById('featureIcon');
      const name = document.getElementById('featureName');
      if (wrapper && icon && name) {
        wrapper.style.display = 'grid';
        icon.textContent = data.icon;
        name.textContent = `You tried to access: ${data.name}`;
      }
    }

    const PLAN_CONFIG = {
      basic: {
        weekly: { amount: 0.99, suffix: '/week' },
        monthly: { amount: 1.99, suffix: '/month' },
        yearly: { amount: 9.99, suffix: '/year' },
      },
      enhanced: {
        weekly: { amount: 1.99, suffix: '/week' },
        monthly: { amount: 4.99, suffix: '/month' },
        yearly: { amount: 49.99, suffix: '/year' },
      },
    };

    const selectedIntervalByPlan = {
      basic: 'monthly',
      enhanced: 'monthly',
    };

    function formatUsd(amount) {
      return `$${amount.toFixed(2)}`;
    }

    function setCardUi(plan) {
      const interval = selectedIntervalByPlan[plan];
      const cfg = PLAN_CONFIG[plan]?.[interval];
      if (!cfg) return;

      const priceEl = document.getElementById(`price-${plan}`);
      if (priceEl) {
        priceEl.innerHTML = `${formatUsd(cfg.amount)}<span>${cfg.suffix}</span>`;
      }

      document.querySelectorAll(`.billing-toggle button[data-plan="${plan}"]`).forEach((button) => {
        button.classList.toggle('active', button.getAttribute('data-interval') === interval);
      });
    }

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      const billingButton = target.closest('.billing-toggle button');
      if (billingButton) {
        const plan = billingButton.getAttribute('data-plan');
        const interval = billingButton.getAttribute('data-interval');
        if (plan && interval && selectedIntervalByPlan[plan]) {
          selectedIntervalByPlan[plan] = interval;
          setCardUi(plan);
        }
      }

      const storeButton = target.closest('.btn-store');
      if (storeButton instanceof HTMLElement) {
        const store = storeButton.getAttribute('data-store');
        if (store && storeButton.getAttribute('href')?.startsWith('#')) {
          event.preventDefault();
          alert(`${store.charAt(0).toUpperCase() + store.slice(1)} Web Store link coming soon!\n\nSubscription is available within the PasteCraft extension after install.`);
        }
      }
    });

    setCardUi('basic');
    setCardUi('enhanced');
  </script>

  <style>
    .feature-attempted {
      grid-template-columns: auto 1fr;
      gap: 1rem;
      align-items: center;
    }

    .feature-attempted strong {
      display: block;
      margin-bottom: 0.35rem;
    }

    .feature-icon {
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      border-radius: 50%;
      background: rgba(162, 207, 212, 0.12);
      font-size: 1.35rem;
    }

    .notice {
      margin-top: 1rem;
    }

    .notice h3 {
      margin: 0 0 0.75rem;
    }
  </style>
</BaseLayout>
