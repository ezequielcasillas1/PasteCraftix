---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/SectionShell.astro';
import PricingCard from '../components/PricingCard.astro';
import { pricingPlans, storeLinks } from '../data/site.js';

const [, basicPlan, enhancedPlan] = pricingPlans;
---

<BaseLayout
  title="Upgrade | PasteCraft"
  description="Unlock cloud sync and AI Lab in PasteCraft for study and productivity workflows. Subscribe inside the extension after install."
  currentPath="/upgrade"
>
  <div class="page-shell">
    <SectionShell
      eyebrow="Upgrade"
      title="You found a feature that needs a higher plan"
      copy="PasteCraft keeps fast copy and save light on day one. Upgrade when you need cloud sync or AI Lab for denser study and work situations."
    >
      <div class="stack">
        <div class="feature-attempted surface-card panel" id="featureAttempted" style="display:none;">
          <span class="feature-icon" id="featureIcon">✨</span>
          <div>
            <strong>Feature preview</strong>
            <p id="featureName" class="section-copy">Premium feature</p>
          </div>
        </div>

        <div class="card-grid three">
          <article class="surface-card panel stack">
            <h3>AI Lab breakdowns</h3>
            <p class="section-copy">Turn dense study or work text into clearer explanations at different comprehension levels.</p>
          </article>
          <article class="surface-card panel stack">
            <h3>AI Lab summaries</h3>
            <p class="section-copy">Pull key points from clipboard content when you need the essentials for review or action.</p>
          </article>
          <article class="surface-card panel stack">
            <h3>Profile image uploads</h3>
            <p class="section-copy">Keep uploaded images in the gallery for profile and widget use.</p>
          </article>
        </div>
      </div>
    </SectionShell>

    <SectionShell
      eyebrow="Choose your plan"
      title="Subscribe inside the extension after install"
      copy="Start checkout from your signed-in PasteCraft extension so the subscription stays on the correct account."
    >
      <div class="card-grid two">
        <PricingCard
          id="upgrade-basic"
          name={basicPlan.name}
          tier={basicPlan.tier}
          price={basicPlan.price}
          cadence={basicPlan.cadence}
          note={basicPlan.note}
          features={basicPlan.features}
          billing={basicPlan.billing}
          dataPlan="basic"
        >
          <div class="button-row">
            <a href={storeLinks.chrome} class="button btn-store" data-store="chrome">Chrome</a>
            <a href={storeLinks.edge} class="ghost-button btn-store" data-store="edge" target="_blank" rel="noopener noreferrer">Edge</a>
          </div>
          <span class="muted">Subscribe inside the extension</span>
        </PricingCard>

        <PricingCard
          id="upgrade-enhanced"
          name={enhancedPlan.name}
          tier={enhancedPlan.tier}
          price={enhancedPlan.price}
          cadence={enhancedPlan.cadence}
          note={enhancedPlan.note}
          features={enhancedPlan.features}
          popular={true}
          billing={enhancedPlan.billing}
          dataPlan="enhanced"
        >
          <div class="button-row">
            <a href={storeLinks.chrome} class="button btn-store" data-store="chrome">Chrome</a>
            <a href={storeLinks.edge} class="ghost-button btn-store" data-store="edge" target="_blank" rel="noopener noreferrer">Edge</a>
          </div>
          <span class="muted">Text AI tools plus sync</span>
        </PricingCard>
      </div>

      <article class="surface-card panel notice">
        <h3>Already have the extension?</h3>
        <p class="section-copy">Close this page, open PasteCraft from your browser toolbar, and use Upgrade in your profile to continue.</p>
      </article>
    </SectionShell>
  </div>

  <script is:inline>
    const featureData = {
      breakdown: { icon: '🧠', name: 'AI Breakdown' },
      summary: { icon: '✨', name: 'AI Summary' },
      image: { icon: '🖼️', name: 'Profile Image Gallery' },
      avatar: { icon: '🖼️', name: 'Profile Image Gallery' },
      cartoon: { icon: '🖼️', name: 'Profile Image Uploads' },
      name: { icon: '📝', name: 'AI Name Generator' },
      gallery: { icon: '🖼️', name: 'Image Gallery' },
    };

    const urlParams = new URLSearchParams(window.location.search);
    const feature = urlParams.get('feature');

    if (feature) {
      const data = featureData[feature] || { icon: '✨', name: 'Premium Feature' };
      const wrapper = document.getElementById('featureAttempted');
      const icon = document.getElementById('featureIcon');
      const name = document.getElementById('featureName');
      if (wrapper && icon && name) {
        wrapper.style.display = 'grid';
        icon.textContent = data.icon;
        name.textContent = `You tried to access: ${data.name}`;
      }
    }

    const PLAN_CONFIG = {
      basic: {
        weekly: { amount: 0.99, suffix: '/week' },
        monthly: { amount: 1.99, suffix: '/month' },
        yearly: { amount: 9.99, suffix: '/year' },
      },
      enhanced: {
        weekly: { amount: 3.99, suffix: '/week' },
        monthly: { amount: 9.99, suffix: '/month' },
        yearly: { amount: 49.99, suffix: '/year' },
      },
    };

    const selectedIntervalByPlan = {
      basic: 'monthly',
      enhanced: 'weekly',
    };

    function formatUsd(amount) {
      return `$${amount.toFixed(2)}`;
    }

    function setCardUi(plan) {
      const interval = selectedIntervalByPlan[plan];
      const cfg = PLAN_CONFIG[plan]?.[interval];
      if (!cfg) return;

      const priceEl = document.getElementById(`price-${plan}`);
      if (priceEl) {
        priceEl.innerHTML = `${formatUsd(cfg.amount)}<span>${cfg.suffix}</span>`;
      }

      document.querySelectorAll(`.billing-toggle button[data-plan="${plan}"]`).forEach((button) => {
        button.classList.toggle('active', button.getAttribute('data-interval') === interval);
      });
    }

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      const billingButton = target.closest('.billing-toggle button');
      if (billingButton) {
        const plan = billingButton.getAttribute('data-plan');
        const interval = billingButton.getAttribute('data-interval');
        if (plan && interval && selectedIntervalByPlan[plan]) {
          selectedIntervalByPlan[plan] = interval;
          setCardUi(plan);
        }
      }

      const storeButton = target.closest('.btn-store');
      if (storeButton instanceof HTMLElement) {
        const store = storeButton.getAttribute('data-store');
        if (store && storeButton.getAttribute('href')?.startsWith('#')) {
          event.preventDefault();
          alert(`${store.charAt(0).toUpperCase() + store.slice(1)} Web Store link coming soon!\n\nSubscription is available within the PasteCraft extension after install.`);
        }
      }
    });

    setCardUi('basic');
    setCardUi('enhanced');
  </script>

  <style>
    .feature-attempted {
      grid-template-columns: auto 1fr;
      gap: 1rem;
      align-items: center;
    }

    .feature-attempted strong {
      display: block;
      margin-bottom: 0.35rem;
    }

    .feature-icon {
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      border-radius: 50%;
      background: rgba(162, 207, 212, 0.12);
      font-size: 1.35rem;
    }

    .notice {
      margin-top: 1rem;
    }

    .notice h3 {
      margin: 0 0 0.75rem;
    }
  </style>
</BaseLayout>
