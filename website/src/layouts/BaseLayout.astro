---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/base.css';

const {
  title = 'PasteCraft | Productivity and study clipboard',
  description = 'PasteCraft helps you copy fast, save valuable study and work information, organize categories and notes, and use AI Lab when you need clarity.',
  currentPath = '/',
  keywords = 'clipboard manager, study tool, productivity extension, clipboard history, browser extension, chrome extension, edge extension, study notes, AI Lab, cloud sync clipboard, copy paste tool',
  canonicalUrl = '',
} = Astro.props;

const siteUrl = 'https://pastecraft.com';
const fullCanonical = canonicalUrl || `${siteUrl}${currentPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={fullCanonical} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#071523" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="PasteCraft" />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:site_name" content="PasteCraft" />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
    
    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "PasteCraft",
      "description": description,
      "applicationCategory": "ProductivityApplication",
      "operatingSystem": "Chrome, Edge, Windows, macOS",
      "url": siteUrl,
      "offers": {
        "@type": "AggregateOffer",
        "lowPrice": "0",
        "highPrice": "9.99",
        "priceCurrency": "USD",
        "offerCount": "3"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "ratingCount": "50"
      }
    })} />
    
    <slot name="head" />
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
