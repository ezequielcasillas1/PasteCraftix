---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/base.css';

const {
  title = 'PasteCraft | Clipboard Manager & History Extension',
  description = 'PasteCraft is a powerful clipboard manager and history tool for Chrome and Edge browsers. Save, organize, and sync your clipboard with optional AI features.',
  currentPath = '/',
  keywords = 'clipboard manager, clipboard history, browser extension, chrome extension, clipboard organizer, cloud sync clipboard, copy paste tool, text snippets, productivity tool',
  canonicalUrl = '',
} = Astro.props;

const siteUrl = 'https://pastecraft.com';
const fullCanonical = canonicalUrl || `${siteUrl}${currentPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={fullCanonical} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f8fafc" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="PasteCraft" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js" defer></script>
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:site_name" content="PasteCraft" />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
    
    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "PasteCraft",
      "description": description,
      "applicationCategory": "ProductivityApplication",
      "operatingSystem": "Chrome, Edge, Windows, macOS",
      "url": siteUrl,
      "offers": {
        "@type": "AggregateOffer",
        "lowPrice": "0",
        "highPrice": "9.99",
        "priceCurrency": "USD",
        "offerCount": "3"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "ratingCount": "50"
      }
    })} />
    
    <slot name="head" />
  </head>
  <body>
    <canvas id="starfield-bg" aria-hidden="true"></canvas>
    <div class="page-content">
      <Header currentPath={currentPath} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      import { createStarfield } from '../features/starfield/create-starfield.js';

      const starfieldCanvas = document.getElementById('starfield-bg');
      if (starfieldCanvas instanceof HTMLCanvasElement) {
        createStarfield(starfieldCanvas);
      }
    </script>
  </body>
</html>

<style>
  #starfield-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .page-content {
    position: relative;
    z-index: 1;
    max-width: 100%;
    overflow-x: clip;
  }

  main {
    max-width: 100%;
    min-width: 0;
  }
</style>
